<UserControl x:Class="JustCryptDns.App.Controls.OperationModeSwitcherControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:JustCryptDns.App.Localization"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="ModeSegmentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Padding" Value="8,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HoverSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverSurface" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverSurface" Property="Background" Value="#20FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Single seamless recessed track holding 5 connected mode toggle switches -->
    <Border x:Name="TrackBorder"
            Background="{DynamicResource Brush.ControlFill}"
            BorderBrush="{DynamicResource Brush.CardBorder}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="4"
            SizeChanged="OnTrackSizeChanged">
        <Grid x:Name="TrackGrid" ClipToBounds="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Seamless vertical hairline separators between the 5 switch slots -->
            <Border Grid.Column="1" Width="1" HorizontalAlignment="Left" Margin="0,9" Background="{DynamicResource Brush.Divider}" Opacity="0.65" IsHitTestVisible="False" />
            <Border Grid.Column="2" Width="1" HorizontalAlignment="Left" Margin="0,9" Background="{DynamicResource Brush.Divider}" Opacity="0.65" IsHitTestVisible="False" />
            <Border Grid.Column="3" Width="1" HorizontalAlignment="Left" Margin="0,9" Background="{DynamicResource Brush.Divider}" Opacity="0.65" IsHitTestVisible="False" />
            <Border Grid.Column="4" Width="1" HorizontalAlignment="Left" Margin="0,9" Background="{DynamicResource Brush.Divider}" Opacity="0.65" IsHitTestVisible="False" />

            <!-- Animated sliding active thumb with glowing/pulsing feedback -->
            <Border x:Name="ActiveThumb"
                    Grid.Column="0"
                    CornerRadius="9"
                    BorderThickness="1.5"
                    IsHitTestVisible="False">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ActiveThumbTransform" X="0" />
                </Border.RenderTransform>
                <Grid>
                    <!-- Inner luminous pulse sheen (blinks smoothly via StepPulse) -->
                    <Border x:Name="ActivePulseOverlay"
                            CornerRadius="8"
                            Opacity="0.22"
                            IsHitTestVisible="False" />
                    <!-- Top illuminated LED accent strip -->
                    <Border x:Name="ActiveTopLed"
                            Height="2.5"
                            Margin="18,0,18,0"
                            VerticalAlignment="Top"
                            CornerRadius="0,0,3,3"
                            Opacity="0.95"
                            IsHitTestVisible="False" />
                </Grid>
            </Border>

            <!-- Segment 0: High Speed -->
            <Button x:Name="BtnHighSpeed" Grid.Column="0" Style="{StaticResource ModeSegmentButtonStyle}" Click="OnHighSpeedClick"
                    ToolTip="{l:Loc Mode_HighSpeed_Desc}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse x:Name="DotHighSpeed" Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center" Fill="#FF9F1C" Opacity="0.3" />
                    <TextBlock x:Name="IconHighSpeed" Style="{StaticResource Text.Icon}" Text="&#xE945;" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="LabelHighSpeed" Text="{l:Loc Mode_HighSpeed}" FontSize="{DynamicResource Font.Size.Body}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>

            <!-- Segment 1: Gaming -->
            <Button x:Name="BtnGaming" Grid.Column="1" Style="{StaticResource ModeSegmentButtonStyle}" Click="OnGamingClick"
                    ToolTip="{l:Loc Mode_Gaming_Desc}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse x:Name="DotGaming" Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center" Fill="#00D4FF" Opacity="0.3" />
                    <TextBlock x:Name="IconGaming" Style="{StaticResource Text.Icon}" Text="&#xE7FC;" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="LabelGaming" Text="{l:Loc Mode_Gaming}" FontSize="{DynamicResource Font.Size.Body}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>

            <!-- Segment 2: Balanced -->
            <Button x:Name="BtnBalanced" Grid.Column="2" Style="{StaticResource ModeSegmentButtonStyle}" Click="OnBalancedClick"
                    ToolTip="{l:Loc Mode_Balanced_Desc}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse x:Name="DotBalanced" Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center" Fill="#4F8CFF" Opacity="0.3" />
                    <TextBlock x:Name="IconBalanced" Style="{StaticResource Text.Icon}" Text="&#xE9E9;" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="LabelBalanced" Text="{l:Loc Mode_Balanced}" FontSize="{DynamicResource Font.Size.Body}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>

            <!-- Segment 3: Auto -->
            <Button x:Name="BtnAuto" Grid.Column="3" Style="{StaticResource ModeSegmentButtonStyle}" Click="OnAutoClick"
                    ToolTip="{l:Loc Mode_Auto_Desc}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse x:Name="DotAuto" Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center" Fill="#2DD4BF" Opacity="0.3" />
                    <TextBlock x:Name="IconAuto" Style="{StaticResource Text.Icon}" Text="&#xE946;" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="LabelAuto" Text="{l:Loc Mode_Auto}" FontSize="{DynamicResource Font.Size.Body}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>

            <!-- Segment 4: Security -->
            <Button x:Name="BtnSecurity" Grid.Column="4" Style="{StaticResource ModeSegmentButtonStyle}" Click="OnSecurityClick"
                    ToolTip="{l:Loc Mode_Security_Desc}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse x:Name="DotSecurity" Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center" Fill="#3DD68C" Opacity="0.3" />
                    <TextBlock x:Name="IconSecurity" Style="{StaticResource Text.Icon}" Text="&#xEA18;" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="LabelSecurity" Text="{l:Loc Mode_Security}" FontSize="{DynamicResource Font.Size.Body}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>
