<Application x:Class="JustCryptDns.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JustCryptDns.App.ViewModels"
             xmlns:views="clr-namespace:JustCryptDns.App.Views"
             xmlns:conv="clr-namespace:JustCryptDns.App.Converters"
             xmlns:l="clr-namespace:JustCryptDns.App.Localization"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 is reserved for the theme palette, inserted by ThemeService at startup. -->
                <ResourceDictionary Source="Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:NullToVisibilityConverter x:Key="NullToCollapsed" Invert="True" />
            <conv:EnumEqualsConverter x:Key="EnumEquals" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:BoolEqualsConverter x:Key="BoolEquals" />
            <conv:AddressListConverter x:Key="AddressList" />
            <conv:LinkSpeedConverter x:Key="LinkSpeed" />
            <conv:WidthToColumnsConverter x:Key="WidthToColumns" />
            <conv:NoAdapterVisibilityConverter x:Key="NoAdapterVisibility" />
            <l:LocKeyConverter x:Key="LocKey" />
            <l:LocFormatConverter x:Key="LocFormat" />

            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PlannedFeatureViewModel}">
                <views:PlannedFeatureView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AppearanceViewModel}">
                <views:AppearanceView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DnsManagerViewModel}">
                <views:DnsManagerView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ResolverLibraryViewModel}">
                <views:ResolverLibraryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RoutingViewModel}">
                <views:RoutingView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:FilteringViewModel}">
                <views:FilteringView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:GamingViewModel}">
                <views:GamingView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}">
                <views:DiagnosticsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LiveMonitorViewModel}">
                <views:LiveMonitorView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
