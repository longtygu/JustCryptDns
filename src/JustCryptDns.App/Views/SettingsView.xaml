<UserControl x:Class="JustCryptDns.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:JustCryptDns.App.ViewModels"
             xmlns:ipc="clr-namespace:JustCryptDns.Core.Ipc;assembly=JustCryptDns.Core"
             xmlns:models="clr-namespace:JustCryptDns.Core.Models;assembly=JustCryptDns.Core"
             xmlns:controls="clr-namespace:JustCryptDns.App.Controls"
             xmlns:l="clr-namespace:JustCryptDns.App.Localization"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="1050"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <UserControl.Resources>
        <Style x:Key="SettingCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="{DynamicResource Card.Gap}" />
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="FontSize" Value="{DynamicResource Font.Size.BodyLarge}" />
        </Style>
        <Style x:Key="RowIcon" TargetType="TextBlock" BasedOn="{StaticResource Text.Icon}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="20" />
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Divider}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Margin" Value="36,14,0,14" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="32,4,32,32" MaxWidth="900" HorizontalAlignment="Stretch">
            <TextBlock Style="{StaticResource Text.PageTitle}" Text="{l:Loc Nav_Settings}" />
            <TextBlock Style="{StaticResource Text.Subtitle}" Text="{l:Loc Page_Settings_Subtitle}" Margin="0,4,0,22" />

            <!-- Notices -->
            <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.WarningSubtle}" BorderBrush="{DynamicResource Brush.Warning}"
                    Padding="16,12" Margin="{DynamicResource Card.Gap}" Visibility="{Binding ShowLoadWarning, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7BA;" Foreground="{DynamicResource Brush.Warning}" Margin="0,0,12,0" />
                    <TextBlock Style="{StaticResource Text.Body}" Text="{l:Loc Settings_LoadWarning}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.DangerSubtle}" BorderBrush="{DynamicResource Brush.Danger}"
                    Padding="16,12" Margin="{DynamicResource Card.Gap}" Visibility="{Binding SaveError, Converter={StaticResource NullToVisibility}}">
                <TextBlock Style="{StaticResource Text.Body}">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource LocFormat}" ConverterParameter="Settings_SaveError">
                            <Binding Path="SaveError" />
                            <Binding Path="Culture" Source="{x:Static l:LocalizationManager.Instance}" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Border>

            <!-- General & Startup -->
            <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{l:Loc Settings_General}" Margin="0,8,0,10" />
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowIcon}" Text="&#xF2B7;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{l:Loc Settings_Language}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc Settings_Language_Desc}" />
                        </StackPanel>
                        <ComboBox Grid.Column="2" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                                  AutomationProperties.Name="{l:Loc Settings_Language}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource LocKey}" ConverterParameter="Lang_">
                                                <Binding />
                                                <Binding Path="Culture" Source="{x:Static l:LocalizationManager.Instance}" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <Border Style="{StaticResource Divider}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowIcon}" Text="&#xE8BB;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{l:Loc Settings_CloseBehavior}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc Settings_CloseBehavior_Desc}" />
                        </StackPanel>
                        <Border Grid.Column="2" Style="{StaticResource SegmentHost}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Radio.Segment}" GroupName="CloseBehavior" Content="{l:Loc CloseBehavior_MinimizeToTray}"
                                             IsChecked="{Binding CloseBehavior, Converter={StaticResource EnumEquals}, ConverterParameter=MinimizeToTray}" />
                                <RadioButton Style="{StaticResource Radio.Segment}" GroupName="CloseBehavior" Content="{l:Loc CloseBehavior_ExitApplication}"
                                             IsChecked="{Binding CloseBehavior, Converter={StaticResource EnumEquals}, ConverterParameter=ExitApplication}" />
                                <RadioButton Style="{StaticResource Radio.Segment}" GroupName="CloseBehavior" Content="{l:Loc CloseBehavior_AskEveryTime}"
                                             IsChecked="{Binding CloseBehavior, Converter={StaticResource EnumEquals}, ConverterParameter=AskEveryTime}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Software Updates (GitHub) -->
            <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{l:Loc Settings_Updates_Section}" Margin="0,16,0,10" />
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowIcon}" Text="&#xE895;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource RowTitle}" Text="{l:Loc Settings_Updates_CurrentTitle}" VerticalAlignment="Center" />
                                <Border Background="{DynamicResource Brush.SubtleHover}" CornerRadius="11" Padding="10,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Text.Mono}" FontSize="{DynamicResource Font.Size.Caption}" FontWeight="SemiBold"
                                               Text="{Binding CurrentAppVersion, StringFormat=v{0}}" />
                                </Border>
                                <Border Margin="8,0,0,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                            <Setter Property="Background" Value="{DynamicResource Brush.NeutralSubtle}" />
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Neutral}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UpdateStatus}" Value="{x:Static models:UpdateCheckStatus.UpdateAvailable}">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Accent}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UpdateStatus}" Value="{x:Static models:UpdateCheckStatus.UpToDate}">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.SuccessSubtle}" />
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Success}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UpdateStatus}" Value="{x:Static models:UpdateCheckStatus.RateLimited}">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.WarningSubtle}" />
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Warning}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UpdateStatus}" Value="{x:Static models:UpdateCheckStatus.Error}">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.DangerSubtle}" />
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Danger}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="{DynamicResource Font.Size.Caption}" FontWeight="SemiBold">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource LocKey}" ConverterParameter="UpdateState_">
                                                <Binding Path="UpdateStatus" />
                                                <Binding Path="Culture" Source="{x:Static l:LocalizationManager.Instance}" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding UpdateStatusMessage}" Margin="0,4,0,0" />
                            <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,2,0,0">
                                <Run Text="{l:Loc Settings_Updates_LastChecked}" />
                                <Run Text=": " />
                                <Run Text="{Binding LastCheckedText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource Button.Primary}" Command="{Binding CheckForUpdatesCommand}"
                                Content="{l:Loc Settings_Updates_Btn_Check}" VerticalAlignment="Center" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />
                    <Grid Margin="36,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{l:Loc Settings_Updates_AutoCheck}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc Settings_Updates_AutoCheck_Desc}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Toggle.Switch}" IsChecked="{Binding AutoCheckForUpdates}" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />
                    <Grid Margin="36,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{l:Loc Settings_Updates_IncludePre}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc Settings_Updates_IncludePre_Desc}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Toggle.Switch}" IsChecked="{Binding IncludePrereleases}" />
                    </Grid>

                    <!-- Release Details Panel -->
                    <Border Background="{DynamicResource Brush.SubtleHover}" CornerRadius="8" Padding="16,14" Margin="36,14,0,0"
                            Visibility="{Binding LatestRelease, Converter={StaticResource NullToVisibility}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{Binding ReleaseHeaderText}" />
                                    <TextBlock Style="{StaticResource Text.Mono}" FontSize="{DynamicResource Font.Size.Caption}"
                                               Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding ReleaseMetaText}" Margin="0,3,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding OpenReleaseOnGitHubCommand}" Content="{l:Loc Settings_Updates_Btn_ViewGitHub}" VerticalAlignment="Top" />
                            </Grid>

                            <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc Settings_Updates_NotesLabel}" Margin="0,4,0,4" />
                            <Border Background="{DynamicResource Brush.ControlFill}" BorderBrush="{DynamicResource Brush.ControlBorder}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,8" MaxHeight="150" Margin="0,0,0,12">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock Style="{StaticResource Text.Body}" FontSize="{DynamicResource Font.Size.Caption}"
                                               Text="{Binding ReleaseNotesDisplay}" />
                                </ScrollViewer>
                            </Border>

                            <WrapPanel>
                                <Button Style="{StaticResource Button.Primary}" Command="{Binding DownloadUpdateCommand}"
                                        Content="{l:Loc Settings_Updates_Btn_Download}"
                                        IsEnabled="{Binding CanDownloadUpdate}"
                                        Visibility="{Binding ShowDownloadButton, Converter={StaticResource BoolToVisibility}}"
                                        Margin="0,0,10,4" />
                                <Button Command="{Binding CancelDownloadCommand}" Content="{l:Loc Settings_Updates_Btn_CancelDownload}"
                                        Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVisibility}}" Margin="0,0,10,4" />
                                <Button Style="{StaticResource Button.Primary}" Command="{Binding InstallUpdateNowCommand}"
                                        Content="{l:Loc Settings_Updates_Btn_InstallNow}"
                                        Visibility="{Binding IsUpdateReadyToInstall, Converter={StaticResource BoolToVisibility}}" Margin="0,0,10,4" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Live Download Progress & Speed Chart -->
                    <Border Background="{DynamicResource Brush.SubtleHover}" CornerRadius="8" Padding="16,14" Margin="36,12,0,0"
                            Visibility="{Binding ShowDownloadChart, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc Settings_Updates_ChartTitle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Text.Mono}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}"
                                           Text="{Binding DownloadSpeedText}" Margin="16,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Style="{StaticResource Text.Mono}" Foreground="{DynamicResource Brush.TextSecondary}"
                                           Text="{Binding DownloadTransferredText}" Margin="16,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Style="{StaticResource Text.Mono}" Foreground="{DynamicResource Brush.TextSecondary}"
                                           Margin="16,0,0,0" VerticalAlignment="Center">
                                    <Run Text="ETA: " />
                                    <Run Text="{Binding DownloadEtaText, Mode=OneWay}" />
                                </TextBlock>
                            </Grid>

                            <controls:UpdateDownloadChartControl x:Name="UpdateSpeedChart" Height="148"
                                                                 AccentBrush="{DynamicResource Brush.Accent}"
                                                                 TrackBrush="{DynamicResource Brush.ControlFill}"
                                                                 GridBrush="{DynamicResource Brush.Divider}"
                                                                 SurfaceBrush="{DynamicResource Brush.ControlFill}"
                                                                 BorderBrush="{DynamicResource Brush.ControlBorder}"
                                                                 TextBrush="{DynamicResource Brush.TextPrimary}"
                                                                 SecondaryTextBrush="{DynamicResource Brush.TextSecondary}"
                                                                 ProgressPercent="{Binding DownloadPercent}" />

                            <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Success}" Margin="0,8,0,0"
                                       Text="{Binding ChecksumStatusText}"
                                       Visibility="{Binding ChecksumStatusText, Converter={StaticResource NullToVisibility}}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}" Margin="0,8,0,0"
                                       Text="{Binding DownloadError}"
                                       Visibility="{Binding DownloadError, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Background & Startup -->
            <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{l:Loc Settings_Startup_Section}" Margin="0,16,0,10" />
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowIcon}" Text="&#xE7E8;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{l:Loc Settings_StartWithWindows}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc Settings_StartWithWindows_Desc}" />
                        </StackPanel>
                        <CheckBox Grid.Column="2" Style="{StaticResource Toggle.Switch}" IsChecked="{Binding StartWithWindows}"
                                  AutomationProperties.Name="{l:Loc Settings_StartWithWindows}" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />
                    <Grid Margin="36,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{l:Loc Settings_StartMinimized}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc Settings_StartMinimized_Desc}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Toggle.Switch}" IsChecked="{Binding StartMinimized}"
                                  AutomationProperties.Name="{l:Loc Settings_StartMinimized}" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />
                    <Grid Margin="36,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{l:Loc Settings_AutoStartDns}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc Settings_AutoStartDns_Desc}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Toggle.Switch}" IsChecked="{Binding AutoStartDnsEngine}"
                                  AutomationProperties.Name="{l:Loc Settings_AutoStartDns}" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />
                    <Grid Margin="36,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{l:Loc Settings_RestoreProfile}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc Settings_RestoreProfile_Desc}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Toggle.Switch}" IsChecked="{Binding RestorePreviousProfile}"
                                  AutomationProperties.Name="{l:Loc Settings_RestoreProfile}" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />
                    <Grid Margin="36,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{l:Loc Settings_GamingOnStartup}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc Settings_GamingOnStartup_Desc}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Toggle.Switch}" IsChecked="{Binding EnableGamingModeOnStartup}"
                                  AutomationProperties.Name="{l:Loc Settings_GamingOnStartup}" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />
                    <Grid Margin="36,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource RowTitle}" Text="{l:Loc Settings_ServiceStatus}" VerticalAlignment="Center" />
                                <Border Margin="12,0,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                            <Setter Property="Background" Value="{DynamicResource Brush.NeutralSubtle}" />
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Neutral}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ServiceState}" Value="{x:Static ipc:ServiceConnectionState.Connected}">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.SuccessSubtle}" />
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Success}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ServiceState}" Value="{x:Static ipc:ServiceConnectionState.AccessDenied}">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.WarningSubtle}" />
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Warning}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ServiceState}" Value="{x:Static ipc:ServiceConnectionState.Error}">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.DangerSubtle}" />
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Danger}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="{DynamicResource Font.Size.Caption}" FontWeight="SemiBold">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource LocKey}" ConverterParameter="ServiceState_">
                                                <Binding Path="ServiceState" />
                                                <Binding Path="Culture" Source="{x:Static l:LocalizationManager.Instance}" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc Settings_ServiceStatus_Desc}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{l:Loc Common_Refresh}" Command="{Binding CheckServiceCommand}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{l:Loc Settings_Appearance}" Margin="0,16,0,10" />
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowIcon}" Text="&#xE790;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{l:Loc Settings_Theme}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc Settings_Theme_Desc}" />
                        </StackPanel>
                        <Border Grid.Column="2" Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Radio.Segment}" GroupName="Theme" Content="{l:Loc Theme_Dark}"
                                             IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter=Dark}" />
                                <RadioButton Style="{StaticResource Radio.Segment}" GroupName="Theme" Content="{l:Loc Theme_Light}"
                                             IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter=Light}" />
                                <RadioButton Style="{StaticResource Radio.Segment}" GroupName="Theme" Content="{l:Loc Theme_System}"
                                             IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter=System}" />
                                <RadioButton Style="{StaticResource Radio.Segment}" GroupName="Theme" Content="{l:Loc Theme_Custom}"
                                             IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter=Custom}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource RowTitle}" Text="{l:Loc Settings_AppearanceLink_Title}" />
                                <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc Settings_AppearanceLink_Desc}" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding OpenAppearanceCommand}" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{l:Loc Settings_OpenAppearance}" />
                                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE76C;" FontSize="11" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Performance & Resource Optimization -->
            <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{l:Loc Settings_Performance_Section}" Margin="0,16,0,10" />
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowIcon}" Text="&#xE945;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{l:Loc Settings_MonitoringMode}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc Settings_MonitoringMode_Desc}" />
                        </StackPanel>
                        <Border Grid.Column="2" Style="{StaticResource SegmentHost}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Radio.Segment}" GroupName="MonMode" Content="{l:Loc MonMode_PowerSaving}"
                                             IsChecked="{Binding MonitoringMode, Converter={StaticResource EnumEquals}, ConverterParameter=PowerSaving}" />
                                <RadioButton Style="{StaticResource Radio.Segment}" GroupName="MonMode" Content="{l:Loc MonMode_Balanced}"
                                             IsChecked="{Binding MonitoringMode, Converter={StaticResource EnumEquals}, ConverterParameter=Balanced}" />
                                <RadioButton Style="{StaticResource Radio.Segment}" GroupName="MonMode" Content="{l:Loc MonMode_Performance}"
                                             IsChecked="{Binding MonitoringMode, Converter={StaticResource EnumEquals}, ConverterParameter=Performance}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource Divider}" />
                    <Grid Margin="36,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{l:Loc Settings_PerfDiag}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc Settings_PerfDiag_Desc}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Toggle.Switch}" IsChecked="{Binding EnablePerformanceDiagnostics}"
                                  AutomationProperties.Name="{l:Loc Settings_PerfDiag}" />
                    </Grid>

                    <Border Background="{DynamicResource Brush.SubtleHover}" CornerRadius="8" Padding="16,12" Margin="36,14,0,0"
                            Visibility="{Binding EnablePerformanceDiagnostics, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <UniformGrid Rows="1" Columns="4" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Label}" Text="Working Set" />
                                    <TextBlock Style="{StaticResource Text.Mono}" FontWeight="SemiBold"
                                               Text="{Binding PerformanceSnapshot.WorkingSetMb, StringFormat={}{0:0.0} MB}" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Label}" Text="Private RAM" />
                                    <TextBlock Style="{StaticResource Text.Mono}" FontWeight="SemiBold"
                                               Text="{Binding PerformanceSnapshot.PrivateMemoryMb, StringFormat={}{0:0.0} MB}" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Label}" Text="Managed Heap" />
                                    <TextBlock Style="{StaticResource Text.Mono}" FontWeight="SemiBold"
                                               Text="{Binding PerformanceSnapshot.ManagedHeapMb, StringFormat={}{0:0.0} MB}" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Label}" Text="Threads / Handles" />
                                    <TextBlock Style="{StaticResource Text.Mono}" Margin="0,3,0,0">
                                        <Run Text="{Binding PerformanceSnapshot.ThreadCount, Mode=OneWay}" />
                                        <Run Text=" / " />
                                        <Run Text="{Binding PerformanceSnapshot.HandleCount, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </UniformGrid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Command="{Binding RefreshPerformanceCommand}" Content="{l:Loc Common_Refresh}" Margin="0,0,8,0" Padding="10,5" />
                                <Button Command="{Binding TrimMemoryCommand}" Content="{l:Loc Settings_PerfDiag_Trim}" Padding="10,5" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- About -->
            <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{l:Loc Settings_About}" Margin="0,16,0,10" />
            <Border Style="{StaticResource SettingCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc Settings_Version}" Margin="0,0,0,12" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}" Text="{Binding Version}" />

                    <TextBlock Grid.Row="1" Style="{StaticResource Text.Caption}" Text="{l:Loc Settings_OS}" Margin="0,0,0,12" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Text.Body}" Text="{Binding OperatingSystemName}" />

                    <TextBlock Grid.Row="2" Style="{StaticResource Text.Caption}" Text="{l:Loc Settings_DataFolder}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Text.Mono}" Text="{Binding DataFolder}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <Button Grid.Row="2" Grid.Column="2" Content="{l:Loc Common_Open}" Margin="12,0,0,8"
                            Command="{Binding OpenFolderCommand}" CommandParameter="{Binding DataFolder}" />

                    <TextBlock Grid.Row="3" Style="{StaticResource Text.Caption}" Text="{l:Loc Settings_LogsFolder}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Text.Mono}" Text="{Binding LogsFolder}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <Button Grid.Row="3" Grid.Column="2" Content="{l:Loc Common_Open}" Margin="12,0,0,8"
                            Command="{Binding OpenFolderCommand}" CommandParameter="{Binding LogsFolder}" />

                    <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE72E;" FontSize="14" Foreground="{DynamicResource Brush.Success}" Margin="0,0,10,0" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc Settings_Privacy}" />
                    </StackPanel>

                    <WrapPanel Grid.Row="5" Grid.ColumnSpan="3" Margin="0,14,0,0">
                        <Button Command="{Binding OpenAboutWindowCommand}" Content="{l:Loc Settings_About_Btn_AppInfo}" Margin="0,0,10,0" />
                        <Button Command="{Binding OpenBugReportCommand}" Content="{l:Loc Settings_About_Btn_BugReport}" />
                    </WrapPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
