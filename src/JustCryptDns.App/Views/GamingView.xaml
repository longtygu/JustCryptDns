<UserControl x:Class="JustCryptDns.App.Views.GamingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:JustCryptDns.App.ViewModels"
             xmlns:models="clr-namespace:JustCryptDns.Core.Models;assembly=JustCryptDns.Core"
             xmlns:l="clr-namespace:JustCryptDns.App.Localization"
             xmlns:controls="clr-namespace:JustCryptDns.App.Controls"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="1350"
             d:DataContext="{d:DesignInstance Type=vm:GamingViewModel}">
    <UserControl.Resources>
        <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="{DynamicResource Card.Gap}" />
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="FontSize" Value="{DynamicResource Font.Size.BodyLarge}" />
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Divider}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Margin" Value="0,14,0,14" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="32,4,32,32" MaxWidth="940">
            <!-- Header & Benchmark Button -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.PageTitle}" Text="{l:Loc Nav_Gaming}" />
                    <TextBlock Style="{StaticResource Text.Subtitle}" Text="{l:Loc Page_Gaming_Subtitle}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource Button.Primary}" Command="{Binding RunBenchmarkCommand}"
                        Content="{l:Loc Gaming_RunBenchmark}" VerticalAlignment="Center" />
            </Grid>

            <!-- Honest Technical Notice -->
            <Border Style="{StaticResource SectionCard}" Background="{DynamicResource Brush.SubtleHover}" Padding="16,12"
                    controls:ChartHoverInfoBehavior.Title="{l:Loc Info_Gaming_Notice_Title}"
                    controls:ChartHoverInfoBehavior.Description="{l:Loc Info_Gaming_Notice_Desc}"
                    controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Info_Gaming_Notice_Meaning}"
                    controls:ChartHoverInfoBehavior.DelaySeconds="1.5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE946;" FontSize="18" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="{l:Loc Gaming_Disclaimer_Title}" />
                        <TextBox Style="{StaticResource TextBox.SelectableReadOnly}" FontSize="{DynamicResource Font.Size.Caption}"
                                 Foreground="{DynamicResource Brush.TextSecondary}" Text="{l:Loc Gaming_Disclaimer_Body}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Gaming + DPI Bypass Synergy Banner -->
            <Border Style="{StaticResource SectionCard}" Padding="16,12"
                    controls:ChartHoverInfoBehavior.Title="{l:Loc Info_Gaming_Synergy_Title}"
                    controls:ChartHoverInfoBehavior.Description="{l:Loc Info_Gaming_Synergy_Desc}"
                    controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Info_Gaming_Synergy_Meaning}"
                    controls:ChartHoverInfoBehavior.DelaySeconds="1.5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE705;" FontSize="18" Foreground="{DynamicResource Brush.Success}" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="{l:Loc Gaming_BypassSynergy_Title}" />
                        <TextBox Style="{StaticResource TextBox.SelectableReadOnly}" FontSize="{DynamicResource Font.Size.Caption}"
                                 Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding BypassSynergySummary, Mode=OneWay}" />
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource Pill}" Background="{DynamicResource Brush.SuccessSubtle}"
                            Visibility="{Binding IsBypassActive, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock FontSize="{DynamicResource Font.Size.Small}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Success}" Text="{l:Loc Bypass_WinProxyActive}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Status / Error Banners (Selectable & Copyable) -->
            <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.DangerSubtle}" BorderBrush="{DynamicResource Brush.Danger}"
                    Padding="16,12" Margin="{DynamicResource Card.Gap}"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource TextBox.SelectableReadOnly}" Text="{Binding ErrorMessage, Mode=OneWay}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource Button.CopyInline}" controls:CopyTextBehavior.CopyText="{Binding ErrorMessage}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.SuccessSubtle}" BorderBrush="{DynamicResource Brush.Success}"
                    Padding="16,12" Margin="{DynamicResource Card.Gap}"
                    Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource TextBox.SelectableReadOnly}" Text="{Binding StatusMessage, Mode=OneWay}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource Button.CopyInline}" controls:CopyTextBehavior.CopyText="{Binding StatusMessage}" />
                </Grid>
            </Border>

            <!-- Live Animated Multi-Domain Benchmark Scanner & Log Card -->
            <Border Style="{StaticResource SectionCard}" BorderBrush="{DynamicResource Brush.Accent}"
                    Visibility="{Binding HasBenchmarkPanel, Converter={StaticResource BoolToVisibility}}"
                    controls:ChartHoverInfoBehavior.Title="{l:Loc Info_Gaming_Scanner_Title}"
                    controls:ChartHoverInfoBehavior.Description="{l:Loc Info_Gaming_Scanner_Desc}"
                    controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Info_Gaming_Scanner_Meaning}"
                    controls:ChartHoverInfoBehavior.DelaySeconds="1.5">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Animated Radar Scanner Icon (stops spinning when idle) -->
                        <Grid Width="38" Height="38" VerticalAlignment="Center">
                            <Border CornerRadius="19" Background="{DynamicResource Brush.AccentSubtle}"
                                    BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1" />
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Grid Width="38" Height="38" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </Grid.RenderTransform>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Opacity" Value="0.35" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBenchmarking}" Value="True">
                                                <Setter Property="Opacity" Value="1.0" />
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="GamingRadarStoryboard">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             From="0" To="360" Duration="0:0:1.05"
                                                                             RepeatBehavior="Forever" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="GamingRadarStoryboard" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Path Stroke="{DynamicResource Brush.Accent}" StrokeThickness="2.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 19,5 A 14,14 0 0 1 33,19" />
                            </Grid>
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Text.SectionTitle}">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource LocKey}" ConverterParameter="">
                                        <Binding Path="BenchmarkHeaderKey" />
                                        <Binding Path="Culture" Source="{x:Static l:LocalizationManager.Instance}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextSecondary}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,0"
                                       Visibility="{Binding IsBenchmarking, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource LocFormat}" ConverterParameter="Resolvers_Scan_CurrentTarget">
                                        <Binding Path="BenchmarkCurrentTarget" />
                                        <Binding Path="Culture" Source="{x:Static l:LocalizationManager.Instance}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>

                        <WrapPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Border Style="{StaticResource Pill}" Background="{DynamicResource Brush.ControlFill}" Margin="0,0,6,0"
                                    ToolTip="Resolvers">
                                <TextBlock Style="{StaticResource Text.Mono}" FontSize="{DynamicResource Font.Size.Small}"
                                           FontWeight="SemiBold" Text="{Binding BenchmarkCounterText}" />
                            </Border>
                            <Border Style="{StaticResource Pill}" Background="{DynamicResource Brush.AccentSubtle}" Margin="0,0,6,0">
                                <TextBlock Style="{StaticResource Text.Mono}" FontSize="{DynamicResource Font.Size.Small}"
                                           FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" Text="{Binding BenchmarkQueryCounterText}" />
                            </Border>
                            <Border Style="{StaticResource Pill}" Background="{DynamicResource Brush.SuccessSubtle}" Margin="0,0,6,0">
                                <TextBlock FontSize="{DynamicResource Font.Size.Small}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Success}">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LocFormat}" ConverterParameter="Gaming_Bench_OkCount">
                                            <Binding Path="BenchmarkSuccessQueries" />
                                            <Binding Path="Culture" Source="{x:Static l:LocalizationManager.Instance}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource Pill}" Background="{DynamicResource Brush.DangerSubtle}" Margin="0,0,6,0">
                                <TextBlock FontSize="{DynamicResource Font.Size.Small}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Danger}">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LocFormat}" ConverterParameter="Gaming_Bench_FailCount">
                                            <Binding Path="BenchmarkFailedQueries" />
                                            <Binding Path="Culture" Source="{x:Static l:LocalizationManager.Instance}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource Pill}" Background="{DynamicResource Brush.SubtleHover}" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource Text.Mono}" FontSize="{DynamicResource Font.Size.Small}"
                                           Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding BenchmarkElapsedDisplay}" />
                            </Border>
                            <Button Style="{StaticResource Button.CopyInline}" Width="26" Height="26" Margin="0,0,6,0"
                                    controls:CopyTextBehavior.CopyText="{Binding BenchmarkLogClipboardText}"
                                    Visibility="{Binding IsBenchmarking, Converter={StaticResource InverseBoolToVisibility}}" />
                            <Button Command="{Binding CancelBenchmarkCommand}" Content="{l:Loc Resolvers_Scan_Cancel}"
                                    Padding="10,4" Margin="0,0,4,0"
                                    Visibility="{Binding IsBenchmarking, Converter={StaticResource BoolToVisibility}}" />
                            <Button Command="{Binding ClearBenchmarkLogCommand}" Content="{l:Loc Resolvers_Scan_ClearLog}"
                                    Padding="10,4"
                                    Visibility="{Binding IsBenchmarking, Converter={StaticResource InverseBoolToVisibility}}" />
                        </WrapPanel>
                    </Grid>

                    <!-- Determinate Animated Progress Bar -->
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding BenchmarkProgressPercent, Mode=OneWay}" Height="8" Margin="0,12,0,12">
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <Border Background="{DynamicResource Brush.ControlFill}"
                                        BorderBrush="{DynamicResource Brush.ControlBorder}" BorderThickness="1"
                                        CornerRadius="4" ClipToBounds="True">
                                    <Grid x:Name="PART_Track">
                                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BenchmarkWasCancelled}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Warning}" />
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsBenchmarking}" Value="False" />
                                                                <Condition Binding="{Binding BenchmarkWasCancelled}" Value="False" />
                                                                <Condition Binding="{Binding BenchmarkFailedQueries}" Value="0" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Success}" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>

                    <!-- Live Multi-Domain Probe Log -->
                    <Border Background="{DynamicResource Brush.ControlFill}" BorderBrush="{DynamicResource Brush.ControlBorder}"
                            BorderThickness="1" CornerRadius="6" Padding="8,6">
                        <ListBox ItemsSource="{Binding BenchmarkLogs}" MaxHeight="220"
                                 Background="Transparent" BorderThickness="0"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="6,3" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemRoot" Background="{TemplateBinding Background}"
                                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource Brush.SubtleHover}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:GamingBenchmarkLogEntry}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="66" />
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="165" />
                                            <ColumnDefinition Width="66" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Style="{StaticResource Text.Mono}" FontSize="{DynamicResource Font.Size.Small}"
                                                   Foreground="{DynamicResource Brush.TextTertiary}" VerticalAlignment="Center"
                                                   Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" />

                                        <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                                    <Setter Property="Padding" Value="8,2" />
                                                    <Setter Property="Background" Value="{DynamicResource Brush.SuccessSubtle}" />
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Success}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Outcome}" Value="Summary">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Accent}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Outcome}" Value="Timeout">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.WarningSubtle}" />
                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Warning}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Outcome}" Value="Failed">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.DangerSubtle}" />
                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Danger}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="{DynamicResource Font.Size.Small}" FontWeight="SemiBold"
                                                       Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource LocKey}" ConverterParameter="">
                                                        <Binding Path="OutcomeKey" />
                                                        <Binding Path="Culture" Source="{x:Static l:LocalizationManager.Instance}" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Border>

                                        <Border Grid.Column="2" Style="{StaticResource Pill}" Padding="8,2" Margin="0,0,6,0"
                                                Background="{DynamicResource Brush.SubtleHover}">
                                            <TextBlock FontSize="{DynamicResource Font.Size.Small}" FontWeight="SemiBold" Text="{Binding ProtocolBadge}" />
                                        </Border>

                                        <TextBlock Grid.Column="3" Style="{StaticResource Text.Caption}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                   Text="{Binding ResolverName}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                   Margin="0,0,8,0" VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="4" Style="{StaticResource Text.Mono}" FontSize="{DynamicResource Font.Size.Small}"
                                                   Foreground="{DynamicResource Brush.AccentText}"
                                                   Text="{Binding Domain}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                   Margin="0,0,8,0" VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="5" Style="{StaticResource Text.Mono}" FontSize="{DynamicResource Font.Size.Small}"
                                                   Text="{Binding LatencyText}" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="6" Style="{StaticResource Text.Caption}" FontSize="{DynamicResource Font.Size.Small}"
                                                   Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding DetailText}"
                                                   ToolTip="{Binding DetailText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Gaming Mode Control & Live DNS Statistics -->
            <Border Style="{StaticResource SectionCard}"
                    controls:ChartHoverInfoBehavior.Title="{l:Loc Info_Gaming_Control_Title}"
                    controls:ChartHoverInfoBehavior.Description="{l:Loc Info_Gaming_Control_Desc}"
                    controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Info_Gaming_Control_Meaning}"
                    controls:ChartHoverInfoBehavior.DelaySeconds="1.5">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource RowTitle}" FontWeight="SemiBold" Text="{l:Loc Dash_GamingMode}" VerticalAlignment="Center" />
                                <Border Style="{StaticResource Pill}" Background="{DynamicResource Brush.SuccessSubtle}" Margin="10,0,0,0"
                                        Visibility="{Binding IsSessionPinned, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock FontSize="{DynamicResource Font.Size.Small}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Success}" Text="{l:Loc Gaming_SessionPinned}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc Gaming_Mode_Desc}" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Toggle.Switch}" IsChecked="{Binding IsGamingModeEnabled}"
                                  AutomationProperties.Name="{l:Loc Dash_GamingMode}" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />
                    <UniformGrid Rows="1" Columns="4">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc Gaming_SelectedResolver}" />
                            <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="{Binding ActiveGamingResolverName}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc Dash_Metric_Latency}" />
                            <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="{Binding LiveLatencyText}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc Dash_Metric_CacheHit}" />
                            <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="{Binding LiveCacheHitText}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc Dash_Metric_Queries}" />
                            <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="{Binding LiveTotalQueries}" Margin="0,4,0,0" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Smart Resolver Selection & Gaming Profiles -->
            <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{l:Loc Gaming_Profiles_Section}" Margin="0,8,0,10" />
            <Border Style="{StaticResource SectionCard}"
                    controls:ChartHoverInfoBehavior.Title="{l:Loc Info_Gaming_Profiles_Title}"
                    controls:ChartHoverInfoBehavior.Description="{l:Loc Info_Gaming_Profiles_Desc}"
                    controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Info_Gaming_Profiles_Meaning}"
                    controls:ChartHoverInfoBehavior.DelaySeconds="1.5">
                <StackPanel>
                    <UniformGrid Columns="3" Rows="1" Margin="0,0,0,12">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc Gaming_PlatformProfile}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding GamingProfiles}" SelectedItem="{Binding SelectedGamingProfile}"
                                      DisplayMemberPath="Name" AutomationProperties.Name="{l:Loc Gaming_PlatformProfile}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc Gaming_OptimizationProfile}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding OptimizationProfiles}" SelectedItem="{Binding SelectedOptimizationProfile}"
                                      AutomationProperties.Name="{l:Loc Gaming_OptimizationProfile}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc Gaming_ManualOverride}" Margin="0,0,0,4" />
                            <StackPanel Orientation="Horizontal">
                                <ComboBox Width="180" ItemsSource="{Binding AvailableResolvers}" SelectedItem="{Binding SelectedOverrideResolver}"
                                          DisplayMemberPath="Name" AutomationProperties.Name="{l:Loc Gaming_ManualOverride}" />
                                <Button Command="{Binding ClearManualOverrideCommand}" Content="{l:Loc Backdrop_Auto}" Margin="6,0,0,0" Padding="10,6" />
                            </StackPanel>
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc Gaming_ProfileDomains}" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource TextBox.SelectableReadOnlyMono}" FontSize="{DynamicResource Font.Size.Caption}"
                                 Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding ActiveProfileDomainsPreview, Mode=OneWay}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource Button.CopyInline}" Width="22" Height="22" Margin="6,0,0,0"
                                controls:CopyTextBehavior.CopyText="{Binding ActiveProfileDomainsPreview}" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc Gaming_CustomProfile_Name}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{l:Loc Gaming_CustomProfile_Name}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc Gaming_CustomProfile_Domains}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding NewProfileDomains, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Mono}"
                                     AutomationProperties.Name="{l:Loc Gaming_CustomProfile_Domains}" />
                        </StackPanel>
                        <Button Grid.Column="2" Command="{Binding AddCustomProfileCommand}" Content="+" VerticalAlignment="Bottom" Padding="14,6" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Benchmark Results -->
            <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{l:Loc Gaming_Benchmark_Title}" Margin="0,8,0,10" />
            <ItemsControl ItemsSource="{Binding BenchmarkResults}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ResolverBenchmarkResult}">
                        <Border Style="{StaticResource SectionCard}" Padding="18,14"
                                controls:ChartHoverInfoBehavior.Title="{l:Loc Info_Gaming_Results_Title}"
                                controls:ChartHoverInfoBehavior.Description="{l:Loc Info_Gaming_Results_Desc}"
                                controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Info_Gaming_Results_Meaning}"
                                controls:ChartHoverInfoBehavior.DelaySeconds="1.5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowTitle}" FontWeight="SemiBold" Text="{Binding ResolverName}" Margin="0,0,10,0" />
                                        <Border Style="{StaticResource Pill}" Background="{DynamicResource Brush.AccentSubtle}" Margin="0,0,8,0">
                                            <TextBlock FontSize="{DynamicResource Font.Size.Small}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.Accent}" Text="{Binding Protocol}" />
                                        </Border>
                                        <Border Style="{StaticResource Pill}" Background="{DynamicResource Brush.SubtleHover}">
                                            <TextBlock FontSize="{DynamicResource Font.Size.Small}" Text="{Binding ReliabilityScore, StringFormat='Score {0:0.0}'}" />
                                        </Border>
                                    </WrapPanel>

                                    <UniformGrid Rows="1" Columns="5" Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Text.Label}" Text="Avg / P95" />
                                            <TextBlock Style="{StaticResource Text.Mono}" FontSize="{DynamicResource Font.Size.Caption}" Margin="0,2,0,0">
                                                <Run Text="{Binding AverageLatencyMs, Mode=OneWay, StringFormat={}{0:0.0}}" />
                                                <Run Text=" / " />
                                                <Run Text="{Binding P95LatencyMs, Mode=OneWay, StringFormat={}{0:0.0} ms}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Text.Label}" Text="Min / Max" />
                                            <TextBlock Style="{StaticResource Text.Mono}" FontSize="{DynamicResource Font.Size.Caption}" Margin="0,2,0,0">
                                                <Run Text="{Binding MinLatencyMs, Mode=OneWay, StringFormat={}{0:0.0}}" />
                                                <Run Text=" / " />
                                                <Run Text="{Binding MaxLatencyMs, Mode=OneWay, StringFormat={}{0:0.0} ms}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Text.Label}" Text="Jitter" />
                                            <TextBlock Style="{StaticResource Text.Mono}" FontSize="{DynamicResource Font.Size.Caption}"
                                                       Text="{Binding JitterMs, StringFormat={}{0:0.0} ms}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Text.Label}" Text="Success" />
                                            <TextBlock Style="{StaticResource Text.Mono}" FontSize="{DynamicResource Font.Size.Caption}"
                                                       Text="{Binding SuccessRatePercent, StringFormat={}{0:0.0}%}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Text.Label}" Text="Timeout" />
                                            <TextBlock Style="{StaticResource Text.Mono}" FontSize="{DynamicResource Font.Size.Caption}"
                                                       Text="{Binding TimeoutRatePercent, StringFormat={}{0:0.0}%}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>

                                <Button Grid.Column="1" VerticalAlignment="Center"
                                        Command="{Binding DataContext.ApplyBenchmarkResolverCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" Content="{l:Loc Common_Apply}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
