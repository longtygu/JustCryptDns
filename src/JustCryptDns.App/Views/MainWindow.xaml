<Window x:Class="JustCryptDns.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:JustCryptDns.App.ViewModels"
        xmlns:l="clr-namespace:JustCryptDns.App.Localization"
        xmlns:controls="clr-namespace:JustCryptDns.App.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        Title="JustCryptDns"
        Width="1180" Height="760" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.WindowBackground}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Font.UI}" FontSize="{DynamicResource Font.Size.Body}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Icon="pack://application:,,,/JustCryptDns;component/Resources/AppIcon.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Vector logo: crisp at every DPI. -->
        <DataTemplate x:Key="Logo">
            <Grid Width="28" Height="28">
                <Border CornerRadius="8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="{DynamicResource Color.Accent}" />
                            <GradientStop Offset="1" Color="#FF7B5CFF" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Viewbox Margin="5">
                    <Canvas Width="24" Height="24">
                        <Path Data="M12,2 L20,5 V11 C20,16 16.5,20.5 12,22 C7.5,20.5 4,16 4,11 V5 Z" Fill="#33FFFFFF" Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round" />
                        <Path Data="M8.5,12 L11,14.5 L15.5,9.5" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Canvas>
                </Viewbox>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="NavItemTemplate" DataType="{x:Type vm:NavItem}">
            <Grid Background="Transparent"
                  ToolTipService.IsEnabled="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}"
                  ToolTipService.Placement="Right">
                <Grid.ToolTip>
                    <ToolTip>
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource LocKey}">
                                    <Binding Path="LabelKey" />
                                    <Binding Path="Culture" Source="{x:Static l:LocalizationManager.Instance}" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </ToolTip>
                </Grid.ToolTip>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Text.Icon}" Text="{Binding Glyph}" FontSize="16" />
                <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Accent}"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,10,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Key}" Value="Settings" />
                                        <Condition Binding="{Binding DataContext.HasAvailableUpdate, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Danger}"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,10,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Key}" Value="Connections" />
                                        <Condition Binding="{Binding DataContext.HasConnectionSecurityAlert, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="{DynamicResource Font.Size.BodyLarge}" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource LocKey}">
                            <Binding Path="LabelKey" />
                            <Binding Path="Culture" Source="{x:Static l:LocalizationManager.Instance}" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Border Background="{DynamicResource Brush.BackgroundDecoration}" IsHitTestVisible="False" />
        <Grid x:Name="ScaledRoot">
            <Grid.LayoutTransform>
                <ScaleTransform ScaleX="{DynamicResource Ui.Scale}" ScaleY="{DynamicResource Ui.Scale}" />
            </Grid.LayoutTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border x:Name="Sidebar" Grid.Column="0" Background="{DynamicResource Brush.Sidebar}"
                BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,1,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="248" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                            <Setter Property="Width" Value="64" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Height="64" Margin="8,0,0,8">
                    <Button Style="{StaticResource Button.Subtle}" Width="48" Height="40" Padding="0"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Command="{Binding ToggleSidebarCommand}"
                            ToolTip="{l:Loc Nav_ToggleSidebar}" AutomationProperties.Name="{l:Loc Nav_ToggleSidebar}">
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE700;" />
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0"
                                Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibility}}">
                        <ContentPresenter ContentTemplate="{StaticResource Logo}" VerticalAlignment="Center" />
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{l:Loc App_Name}" FontSize="{DynamicResource Font.Size.AppName}" FontWeight="SemiBold" />
                            <TextBlock Text="{l:Loc App_Tagline}" FontSize="{DynamicResource Font.Size.Small}" Foreground="{DynamicResource Brush.TextTertiary}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <ListBox Grid.Row="1" Style="{StaticResource Nav.List}" ItemContainerStyle="{StaticResource Nav.Item}"
                         ItemsSource="{Binding NavItemsView}" SelectedItem="{Binding SelectedNavItem}"
                         ItemTemplate="{StaticResource NavItemTemplate}" PreviewMouseLeftButtonUp="OnNavListMouseUp">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="16,10,12,4" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.TextTertiary}"
                                               Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource LocKey}">
                                                <Binding Path="Name" />
                                                <Binding Path="Culture" Source="{x:Static l:LocalizationManager.Instance}" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>

                <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="0,6,0,10">
                    <StackPanel>
                        <Button Style="{StaticResource Button.Subtle}" Height="40" Margin="8,2" Padding="0"
                                HorizontalContentAlignment="Stretch"
                                Foreground="{DynamicResource Brush.TextSecondary}"
                                Command="{Binding OpenAboutCommand}"
                                ToolTipService.IsEnabled="{Binding IsSidebarCollapsed}"
                                ToolTipService.Placement="Right"
                                ToolTip="{l:Loc Nav_About}"
                                AutomationProperties.Name="{l:Loc Nav_About}">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE946;" FontSize="16" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="{DynamicResource Font.Size.BodyLarge}"
                                           Text="{l:Loc Nav_About}" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibility}}" />
                            </Grid>
                        </Button>
                        <ListBox Style="{StaticResource Nav.List}" ItemContainerStyle="{StaticResource Nav.Item}"
                                 ItemsSource="{Binding FooterItems}" SelectedItem="{Binding SelectedFooterItem}"
                                 ItemTemplate="{StaticResource NavItemTemplate}" PreviewMouseLeftButtonUp="OnNavListMouseUp" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Global Security Strip & Quick Command Palette Trigger -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,4,8,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource Button.Subtle}" Height="28" Padding="9,0" Margin="0,0,6,0"
                            Command="{Binding NavigateFromStripCommand}" CommandParameter="{x:Static vm:PageKeys.DnsManager}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Neutral}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDnsProtected}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDnsVpnDeferred}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDnsCaptivePaused}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{l:Loc Strip_Dns}" FontSize="11.5" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding DnsStripValue}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource Button.Subtle}" Height="28" Padding="9,0" Margin="0,0,6,0"
                            Command="{Binding NavigateFromStripCommand}" CommandParameter="{x:Static vm:PageKeys.Bypass}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Neutral}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDpiActive}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{l:Loc Strip_Dpi}" FontSize="11.5" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding DpiStripValue}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource Button.Subtle}" Height="28" Padding="9,0" Margin="0,0,6,0"
                            Command="{Binding NavigateFromStripCommand}" CommandParameter="{x:Static vm:PageKeys.Connections}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Neutral}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLeakGuardActive}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{l:Loc Strip_LeakGuard}" FontSize="11.5" Foreground="{DynamicResource Brush.TextSecondary}" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource Button.Subtle}" Height="28" Padding="9,0" Margin="0,0,8,0"
                            Command="{Binding NavigateFromStripCommand}" CommandParameter="{x:Static vm:PageKeys.Connections}"
                            Visibility="{Binding IsLockdownActive, Converter={StaticResource BoolToVisibility}}">
                        <Border Background="{DynamicResource Brush.DangerSubtle}" CornerRadius="5" Padding="6,2">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Danger}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="{l:Loc Strip_Lockdown}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Danger}" />
                            </StackPanel>
                        </Border>
                    </Button>

                    <Button Style="{StaticResource Button.Base}" Height="28" Padding="10,0"
                            Command="{Binding OpenCommandPaletteCommand}" ToolTip="{l:Loc Strip_SearchHint}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE721;" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock Text="{l:Loc Strip_SearchHint}" FontSize="11.5" Foreground="{DynamicResource Brush.TextSecondary}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource Button.Caption}" Content="&#xE921;" Click="OnMinimize"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="{l:Loc Window_Minimize}" AutomationProperties.Name="{l:Loc Window_Minimize}" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource Button.Caption}" Content="&#xE922;" Click="OnMaximizeRestore"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="{l:Loc Window_Maximize}" AutomationProperties.Name="{l:Loc Window_Maximize}" />
                    <Button Style="{StaticResource Button.CaptionClose}" Content="&#xE8BB;" Click="OnClose"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="{l:Loc Window_Close}" AutomationProperties.Name="{l:Loc Window_Close}" />
                </StackPanel>
            </Grid>

            <controls:AnimatedContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
        </Grid>

        <!-- Command Palette modal overlay (Ctrl+K) -->
        <Grid Grid.ColumnSpan="2" Background="#99000000" MouseDown="OnCommandPaletteBackdropMouseDown"
              Visibility="{Binding IsCommandPaletteOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource Card}" Width="560" VerticalAlignment="Top" Margin="0,68,0,0"
                    Background="{DynamicResource Brush.Popup}" BorderBrush="{DynamicResource Brush.ControlBorder}"
                    MouseDown="OnCommandPaletteCardMouseDown">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc CmdPalette_Title}" Margin="0,0,0,8" />
                    <TextBox x:Name="CommandPaletteSearchBox"
                             Text="{Binding CommandPaletteQuery, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{l:Loc CmdPalette_Placeholder}" Margin="0,0,0,10" />
                    <ListBox x:Name="CommandPaletteListBox"
                             Style="{StaticResource Nav.List}"
                             MaxHeight="320"
                             ItemsSource="{Binding FilteredPaletteCommands}"
                             SelectedItem="{Binding SelectedPaletteCommand}"
                             PreviewMouseLeftButtonUp="OnCommandPaletteItemMouseUp"
                             Visibility="{Binding HasPaletteMatches, Converter={StaticResource BoolToVisibility}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CommandPaletteItem}">
                                <Grid Margin="4,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Text.Icon}" Text="{Binding Glyph}" FontSize="14" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="{DynamicResource Font.Size.Body}"
                                               Foreground="{DynamicResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource LocKey}">
                                                <Binding Path="LabelKey" />
                                                <Binding Path="Culture" Source="{x:Static l:LocalizationManager.Instance}" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <Border Grid.Column="2" Background="{DynamicResource Brush.ControlFill}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock FontSize="10.5" Foreground="{DynamicResource Brush.TextSecondary}">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource LocKey}">
                                                    <Binding Path="CategoryKey" />
                                                    <Binding Path="Culture" Source="{x:Static l:LocalizationManager.Instance}" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc CmdPalette_Empty}"
                               Margin="4,10" HorizontalAlignment="Center"
                               Visibility="{Binding HasPaletteMatches, Converter={StaticResource InverseBoolToVisibility}}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc CmdPalette_Hint}"
                               Margin="0,10,0,0" Foreground="{DynamicResource Brush.TextTertiary}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Close behavior confirmation overlay (when CloseBehavior is AskEveryTime) -->
        <Grid Grid.ColumnSpan="2" Background="#99000000"
              Visibility="{Binding IsClosePromptOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource Card}" MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource Brush.Popup}" BorderBrush="{DynamicResource Brush.ControlBorder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{l:Loc ClosePrompt_Title}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc ClosePrompt_Body}" Margin="0,6,0,16" />
                    <CheckBox Style="{StaticResource Toggle.Switch}" IsChecked="{Binding RememberCloseChoice}"
                              Content="{l:Loc ClosePrompt_Remember}" Margin="0,0,0,20" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{l:Loc Common_Cancel}" Command="{Binding CancelClosePromptCommand}" Margin="0,0,8,0" />
                        <Button Content="{l:Loc CloseBehavior_ExitApplication}" Command="{Binding ConfirmExitApplicationCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource Button.Primary}" Content="{l:Loc CloseBehavior_MinimizeToTray}"
                                Command="{Binding ConfirmMinimizeToTrayCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        </Grid>
    </Grid>
</Window>
