<UserControl x:Class="JustCryptDns.App.Views.ConnectionMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:JustCryptDns.App.ViewModels"
             xmlns:models="clr-namespace:JustCryptDns.Core.Models;assembly=JustCryptDns.Core"
             xmlns:l="clr-namespace:JustCryptDns.App.Localization"
             xmlns:controls="clr-namespace:JustCryptDns.App.Controls"
             mc:Ignorable="d" d:DesignWidth="1060" d:DesignHeight="880"
             d:DataContext="{d:DesignInstance Type=vm:ConnectionMonitorViewModel}">
    <UserControl.Resources>
        <Style x:Key="CompactCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource Button.Base}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
        </Style>

        <Style x:Key="ToolbarPrimaryButton" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
        </Style>

        <Style x:Key="LockdownButton" TargetType="Button" BasedOn="{StaticResource Button.Base}">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{DynamicResource Brush.DangerSubtle}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLockdownActive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolbarOptionCheckBox" TargetType="CheckBox" BasedOn="{StaticResource Toggle.Switch}">
            <Setter Property="Margin" Value="0,3,14,3" />
            <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
        </Style>

        <Style x:Key="InlineEditTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="32,4,32,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Margin="0,0,0,10">
                <TextBlock Style="{StaticResource Text.PageTitle}" Text="{l:Loc Nav_Connections}" />
                <TextBlock Style="{StaticResource Text.Subtitle}" Text="{l:Loc Page_Connections_Subtitle}" Margin="0,3,0,0" />
            </StackPanel>

            <!-- Action Toolbar & Filter -->
            <Border Grid.Row="1" Style="{StaticResource CompactCard}"
                    controls:ChartHoverInfoBehavior.Title="{l:Loc Info_Connections_Toolbar_Title}"
                    controls:ChartHoverInfoBehavior.Description="{l:Loc Info_Connections_Toolbar_Desc}"
                    controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Info_Connections_Toolbar_Meaning}"
                    controls:ChartHoverInfoBehavior.DelaySeconds="1.5">
                <StackPanel>
                    <WrapPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ToolbarButton}"
                                Command="{Binding BlockSelectedIpCommand}"
                                Content="{l:Loc Conn_Btn_BlockSelected}" />
                        <Button Style="{StaticResource ToolbarButton}"
                                Command="{Binding UnblockSelectedIpCommand}"
                                Content="{l:Loc Conn_Btn_UnblockSelected}" />
                        <Button Style="{StaticResource ToolbarButton}"
                                Command="{Binding BlockSelectedAppCommand}"
                                Content="{l:Loc Conn_Btn_BlockApp}" />
                        <Button Style="{StaticResource ToolbarButton}"
                                Command="{Binding OpenUnblockWebsiteModalCommand}"
                                Content="{l:Loc Conn_Btn_UnblockWebsite}" />
                        <Button Style="{StaticResource ToolbarButton}"
                                Command="{Binding OpenBlockedListModalCommand}"
                                Content="{Binding BlockedListButtonLabel}" />
                        <Button Style="{StaticResource ToolbarButton}"
                                Command="{Binding OpenBlockedAppsModalCommand}"
                                Content="{Binding BlockedAppsButtonLabel}" />
                        <Button Style="{StaticResource ToolbarPrimaryButton}"
                                Command="{Binding SyncBlocklistCommand}"
                                Content="{Binding SyncButtonLabel}" />
                        <Button Style="{StaticResource ToolbarButton}"
                                Command="{Binding OpenBlockCidrModalCommand}"
                                Content="{l:Loc Conn_Btn_BlockCidr}" />
                        <Button Style="{StaticResource ToolbarButton}"
                                Command="{Binding OpenNotesModalCommand}"
                                Content="{l:Loc Conn_Btn_ManageNotes}" />
                        <Button Style="{StaticResource ToolbarButton}"
                                Command="{Binding ExportCsvCommand}"
                                Content="{l:Loc Conn_Btn_ExportCsv}" />
                        <Button Style="{StaticResource ToolbarButton}"
                                Command="{Binding ClearClosedConnectionsCommand}"
                                Content="{l:Loc Conn_Btn_ClearClosed}" />
                    </WrapPanel>

                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="290" />
                        </Grid.ColumnDefinitions>

                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox Style="{StaticResource ToolbarOptionCheckBox}"
                                      IsChecked="{Binding EnableOnlineLookup}"
                                      Content="{l:Loc Conn_Opt_OnlineLookup}" />
                            <CheckBox Style="{StaticResource ToolbarOptionCheckBox}"
                                      IsChecked="{Binding AlertNewUnknownProcess}"
                                      Content="{l:Loc Conn_Opt_AlertNewProcess}" />
                            <CheckBox Style="{StaticResource ToolbarOptionCheckBox}"
                                      IsChecked="{Binding HideLanConnections}"
                                      Content="{l:Loc Conn_Opt_HideLan}" />
                            <CheckBox Style="{StaticResource ToolbarOptionCheckBox}"
                                      IsChecked="{Binding AutoScroll}"
                                      Content="{l:Loc Conn_Opt_AutoScroll}" />
                        </WrapPanel>

                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Height="30"
                                     AutomationProperties.Name="{l:Loc Conn_Filter_Placeholder}" />
                            <TextBlock Text="{l:Loc Conn_Filter_Placeholder}"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Margin="12,0,12,0"
                                       FontSize="{DynamicResource Font.Size.Caption}"
                                       Foreground="{DynamicResource Brush.TextTertiary}"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SearchQuery}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Multi-Layer Security Shield Bar -->
            <Border Grid.Row="2" Style="{StaticResource CompactCard}"
                    controls:ChartHoverInfoBehavior.Title="{l:Loc Info_Connections_Shield_Title}"
                    controls:ChartHoverInfoBehavior.Description="{l:Loc Info_Connections_Shield_Desc}"
                    controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Info_Connections_Shield_Meaning}"
                    controls:ChartHoverInfoBehavior.DelaySeconds="1.5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Pill}" Background="{DynamicResource Brush.AccentSubtle}" Margin="0,2,12,2">
                            <TextBlock FontSize="{DynamicResource Font.Size.Small}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Accent}" Text="{l:Loc Conn_Shield_SectionTitle}" />
                        </Border>
                        <CheckBox Style="{StaticResource ToolbarOptionCheckBox}"
                                  IsChecked="{Binding EnableDnsLeakGuard}"
                                  Content="{l:Loc Conn_Opt_DnsLeakGuard}" />
                        <CheckBox Style="{StaticResource ToolbarOptionCheckBox}"
                                  IsChecked="{Binding EnableThreatIntelligence}"
                                  Content="{l:Loc Conn_Opt_ThreatShield}" />
                        <CheckBox Style="{StaticResource ToolbarOptionCheckBox}"
                                  IsChecked="{Binding AutoBlockDetectedThreats}"
                                  Content="{l:Loc Conn_Opt_AutoBlockThreat}" />
                        <CheckBox Style="{StaticResource ToolbarOptionCheckBox}"
                                  IsChecked="{Binding VerifyProcessSignatures}"
                                  Content="{l:Loc Conn_Opt_VerifySignatures}" />
                    </WrapPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                                   Text="{Binding ThreatFeedSummaryText}" Margin="8,0,10,0" />
                        <Button Padding="10,5" FontSize="{DynamicResource Font.Size.Caption}" Margin="0,0,8,0"
                                Command="{Binding UpdateThreatFeedsCommand}"
                                Content="{l:Loc Conn_Btn_UpdateThreatFeeds}" />
                        <Button Style="{StaticResource LockdownButton}"
                                Command="{Binding ToggleEmergencyLockdownCommand}"
                                Content="{Binding LockdownButtonLabel}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Critical & Security Alerts -->
            <StackPanel Grid.Row="3">
                <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,6"
                        Background="{DynamicResource Brush.DangerSubtle}" BorderBrush="{DynamicResource Brush.Danger}"
                        Visibility="{Binding IsLockdownActive, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                   Text="{l:Loc Conn_Banner_LockdownActive}" />
                        <Button Grid.Column="1" Style="{StaticResource Button.Primary}" Padding="12,5"
                                Command="{Binding ToggleEmergencyLockdownCommand}"
                                Content="{l:Loc Conn_Btn_UnlockNetwork}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Padding="14,9" Margin="0,0,0,6"
                        Background="{DynamicResource Brush.DangerSubtle}" BorderBrush="{DynamicResource Brush.Danger}"
                        Visibility="{Binding ThreatAlertText, Converter={StaticResource NullToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}"
                                   FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding ThreatAlertText}" />
                        <Button Grid.Column="1" Style="{StaticResource Button.Subtle}" Padding="8,4"
                                Command="{Binding DismissThreatAlertCommand}" Content="&#xE8BB;"
                                FontFamily="{StaticResource Font.Icons}" FontSize="11" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Padding="14,9" Margin="0,0,0,6"
                        Background="{DynamicResource Brush.WarningSubtle}" BorderBrush="{DynamicResource Brush.Warning}"
                        Visibility="Collapsed"
                        controls:DismissBannerBehavior.BannerContent="{Binding IsWindowsFirewallEnabled}"
                        controls:DismissBannerBehavior.InvertBool="True"
                        controls:DismissBannerBehavior.PersistKey="ConnFirewallDisabled">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextPrimary}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                   Text="{l:Loc Conn_Banner_FirewallDisabled}" />
                        <Button Grid.Column="1" Style="{StaticResource Button.DismissInline}"
                                controls:DismissBannerBehavior.IsDismissButton="True" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Padding="14,9" Margin="0,0,0,6"
                        Background="{DynamicResource Brush.WarningSubtle}" BorderBrush="{DynamicResource Brush.Warning}"
                        Visibility="Collapsed"
                        controls:DismissBannerBehavior.BannerContent="{Binding RequiresElevationHint}"
                        controls:DismissBannerBehavior.PersistKey="ConnRequiresElevation">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextPrimary}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                   Text="{l:Loc Conn_Banner_RequiresElevation}" />
                        <Button Grid.Column="1" Style="{StaticResource Button.DismissInline}"
                                controls:DismissBannerBehavior.IsDismissButton="True" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Padding="14,9" Margin="0,0,0,6"
                        Background="{DynamicResource Brush.WarningSubtle}" BorderBrush="{DynamicResource Brush.Warning}"
                        Visibility="{Binding NewProcessAlertText, Converter={StaticResource NullToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextPrimary}"
                                   FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding NewProcessAlertText}" />
                        <Button Grid.Column="1" Style="{StaticResource Button.Subtle}" Padding="8,4"
                                Command="{Binding DismissProcessAlertCommand}" Content="&#xE8BB;"
                                FontFamily="{StaticResource Font.Icons}" FontSize="11" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Status / Feedback Banner -->
            <Border Grid.Row="4" Padding="14,9" Margin="0,0,0,8" Visibility="Collapsed"
                    controls:DismissBannerBehavior.BannerContent="{Binding StatusBannerText}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Setter Property="Background" Value="{DynamicResource Brush.SuccessSubtle}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusBannerIsError}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.DangerSubtle}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource TextBox.SelectableReadOnly}"
                             Text="{Binding StatusBannerText, Mode=OneWay}"
                             Margin="0,0,8,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource Button.CopyInline}"
                                controls:CopyTextBehavior.CopyText="{Binding StatusBannerText}" />
                        <Button Style="{StaticResource Button.DismissInline}" Margin="4,0,0,0"
                                controls:DismissBannerBehavior.IsDismissButton="True" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Virtualized Live Connection Table + Master-Detail Inspector Drawer -->
            <Grid Grid.Row="5" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10"
                        controls:ChartHoverInfoBehavior.Title="{l:Loc Info_Connections_Grid_Title}"
                        controls:ChartHoverInfoBehavior.Description="{l:Loc Info_Connections_Grid_Desc}"
                        controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Info_Connections_Grid_Meaning}"
                        controls:ChartHoverInfoBehavior.DelaySeconds="1.5">
                <DataGrid x:Name="ConnectionsGrid"
                          ItemsSource="{Binding ConnectionsView}"
                          SelectedItem="{Binding SelectedConnection, Mode=TwoWay}"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          BeginningEdit="OnGridBeginningEdit"
                          CellEditEnding="OnGridCellEditEnding">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsThreatMatch}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.DangerSubtle}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ConnectionDisplayStatus.BlockedIp}">
                                    <Setter Property="Background" Value="{DynamicResource Brush.DangerSubtle}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ConnectionDisplayStatus.BlockedRange}">
                                    <Setter Property="Background" Value="{DynamicResource Brush.DangerSubtle}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsAppBlocked}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.DangerSubtle}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ConnectionDisplayStatus.Closed}">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
                                    <Setter Property="Opacity" Value="0.72" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{l:Loc Conn_Ctx_CopyIp}"
                                      Command="{Binding PlacementTarget.DataContext.CopySelectedIpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="{l:Loc Conn_Ctx_BlockIp}"
                                      Command="{Binding PlacementTarget.DataContext.BlockSelectedIpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="{l:Loc Conn_Ctx_UnblockIp}"
                                      Command="{Binding PlacementTarget.DataContext.UnblockSelectedIpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Separator />
                            <MenuItem Header="{l:Loc Conn_Ctx_BlockApp}"
                                      Command="{Binding PlacementTarget.DataContext.BlockSelectedAppCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="{l:Loc Conn_Ctx_UnblockApp}"
                                      Command="{Binding PlacementTarget.DataContext.UnblockSelectedAppCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Separator />
                            <MenuItem Header="{l:Loc Conn_Ctx_CheckAbuseIpDb}"
                                      Command="{Binding PlacementTarget.DataContext.InspectIpAbuseIpDbCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="{l:Loc Conn_Ctx_CheckVirusTotal}"
                                      Command="{Binding PlacementTarget.DataContext.InspectIpVirusTotalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Separator />
                            <MenuItem Header="{l:Loc Conn_Ctx_EditNote}"
                                      Command="{Binding PlacementTarget.DataContext.RequestEditNoteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{l:Loc Conn_Col_FirstSeen}" Binding="{Binding FirstSeenText}" Width="72" IsReadOnly="True" />
                        <DataGridTextColumn Header="{l:Loc Conn_Col_LastSeen}" Binding="{Binding LastSeenText}" Width="72" IsReadOnly="True" />
                        <DataGridTextColumn Header="{l:Loc Conn_Col_Process}" Binding="{Binding ProcessName}" Width="125" IsReadOnly="True" />
                        <DataGridTextColumn Header="{l:Loc Conn_Col_Proto}" Binding="{Binding ProtocolLabel}" Width="52" IsReadOnly="True" />
                        <DataGridTextColumn Header="{l:Loc Conn_Col_RemoteIp}" Binding="{Binding RemoteIp}" Width="128" IsReadOnly="True" />
                        <DataGridTextColumn Header="{l:Loc Conn_Col_Port}" Binding="{Binding PortText}" Width="74" IsReadOnly="True" />
                        <DataGridTextColumn Header="{l:Loc Conn_Col_Count}" Binding="{Binding ConnectionCount}" Width="52" IsReadOnly="True" />
                        <DataGridTextColumn Header="{l:Loc Conn_Col_Domain}" Binding="{Binding Domain}" Width="155*" IsReadOnly="True" />
                        <DataGridTextColumn Header="{l:Loc Conn_Col_Org}" Binding="{Binding Organization}" Width="145" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="{l:Loc Conn_Col_Trust}" Width="138" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:ConnectionRowViewModel}">
                                    <Border CornerRadius="9" Padding="8,2" HorizontalAlignment="Left"
                                            ToolTip="{Binding TrustTooltip}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Brush.NeutralSubtle}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TrustLevel}" Value="{x:Static models:ProcessTrustLevel.TrustedSystem}">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.SuccessSubtle}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TrustLevel}" Value="{x:Static models:ProcessTrustLevel.Signed}">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.SuccessSubtle}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TrustLevel}" Value="{x:Static models:ProcessTrustLevel.Unsigned}">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.WarningSubtle}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TrustLevel}" Value="{x:Static models:ProcessTrustLevel.Suspicious}">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.DangerSubtle}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsAppBlocked}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.DangerSubtle}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsThreatMatch}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.DangerSubtle}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding TrustBadgeText}" FontSize="{DynamicResource Font.Size.Small}"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="120">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Neutral}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TrustLevel}" Value="{x:Static models:ProcessTrustLevel.TrustedSystem}">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TrustLevel}" Value="{x:Static models:ProcessTrustLevel.Signed}">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TrustLevel}" Value="{x:Static models:ProcessTrustLevel.Unsigned}">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TrustLevel}" Value="{x:Static models:ProcessTrustLevel.Suspicious}">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsAppBlocked}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsThreatMatch}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{l:Loc Conn_Col_Status}" Width="112" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:ConnectionRowViewModel}">
                                    <Border CornerRadius="9" Padding="8,2" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Brush.SuccessSubtle}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ConnectionDisplayStatus.Closed}">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.NeutralSubtle}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ConnectionDisplayStatus.BlockedIp}">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.DangerSubtle}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ConnectionDisplayStatus.BlockedRange}">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.DangerSubtle}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusText}" FontSize="{DynamicResource Font.Size.Small}" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ConnectionDisplayStatus.Closed}">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Neutral}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ConnectionDisplayStatus.BlockedIp}">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ConnectionDisplayStatus.BlockedRange}">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:Name="NoteColumn"
                                            Header="{l:Loc Conn_Col_Note}"
                                            Binding="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                            EditingElementStyle="{StaticResource InlineEditTextBox}"
                                            Width="135" IsReadOnly="False" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Master-Detail Inspector Drawer -->
            <Border Grid.Column="1" Width="320" Margin="10,0,0,0" Style="{StaticResource Card}" Padding="16"
                    Visibility="{Binding IsInspectorOpen, Converter={StaticResource BoolToVisibility}}">
                <Grid Visibility="{Binding SelectedConnection, Converter={StaticResource NullToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{l:Loc ConnInspector_Title}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource Button.Subtle}" Width="28" Height="28" Padding="0"
                                Command="{Binding CloseInspectorCommand}" ToolTip="{l:Loc ConnInspector_Close}">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8BB;" FontSize="11" />
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel DataContext="{Binding SelectedConnection}">
                            <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc ConnInspector_Process}" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="{Binding ProcessName}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding ProcessId, StringFormat='PID: {0}'}" Margin="0,2,0,4" />
                            <TextBox Style="{StaticResource TextBox.SelectableReadOnlyMono}" Text="{Binding ExecutablePath, Mode=OneWay}"
                                     Visibility="{Binding ExecutablePath, Converter={StaticResource NullToVisibility}}" Margin="0,0,0,12" />

                            <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc ConnInspector_Endpoint}" Margin="0,4,0,4" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBox Style="{StaticResource TextBox.SelectableReadOnlyMono}" Text="{Binding RemoteIp, Mode=OneWay}" Margin="0,0,6,0" />
                                <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding PortText, StringFormat=':{0}'}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Domain}" TextWrapping="Wrap"
                                       Visibility="{Binding Domain, Converter={StaticResource NullToVisibility}}" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,0,12">
                                <Run Text="{Binding ProtocolLabel, Mode=OneWay}" />
                                <Run Text=" · " />
                                <Run Text="{Binding StatusText, Mode=OneWay}" />
                                <Run Text=" · " />
                                <Run Text="{Binding LastSeenText, Mode=OneWay}" />
                            </TextBlock>

                            <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc ConnInspector_Trust}" Margin="0,4,0,4" />
                            <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Organization}"
                                       Visibility="{Binding Organization, Converter={StaticResource NullToVisibility}}" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource Text.Caption}" FontWeight="SemiBold" Text="{Binding TrustBadgeText}" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}"
                                       Text="{Binding ThreatLabel}"
                                       Visibility="{Binding ThreatLabel, Converter={StaticResource NullToVisibility}}" Margin="0,0,0,10" />

                            <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc ConnInspector_Note}" Margin="0,4,0,4" />
                            <TextBox Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,12" />

                            <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc ConnInspector_Actions}" Margin="0,4,0,6" />
                            <WrapPanel Orientation="Horizontal">
                                <Button Content="{l:Loc Conn_Ctx_CopyIp}" Margin="0,0,6,6" Padding="10,5"
                                        Command="{Binding DataContext.CopySelectedIpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <Button Content="{l:Loc Conn_Ctx_BlockIp}" Margin="0,0,6,6" Padding="10,5"
                                        Command="{Binding DataContext.BlockSelectedIpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <Button Content="{l:Loc Conn_Ctx_UnblockIp}" Margin="0,0,6,6" Padding="10,5"
                                        Command="{Binding DataContext.UnblockSelectedIpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <Button Content="{l:Loc Conn_Ctx_BlockApp}" Margin="0,0,6,6" Padding="10,5"
                                        Command="{Binding DataContext.BlockSelectedAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <Button Content="{l:Loc Conn_Ctx_UnblockApp}" Margin="0,0,6,6" Padding="10,5"
                                        Command="{Binding DataContext.UnblockSelectedAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <Button Content="{l:Loc Conn_Ctx_CheckAbuseIpDb}" Margin="0,0,6,6" Padding="10,5"
                                        Command="{Binding DataContext.InspectIpAbuseIpDbCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <Button Content="{l:Loc Conn_Ctx_CheckVirusTotal}" Margin="0,0,6,6" Padding="10,5"
                                        Command="{Binding DataContext.InspectIpVirusTotalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

            <!-- Summary Status Bar -->
            <Border Grid.Row="6" Style="{StaticResource Card}" Padding="16,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc Conn_Stat_Active}" Margin="0,0,6,0" />
                        <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Success}"
                                   Text="{Binding ActiveCount}" Margin="0,0,16,0" />

                        <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc Conn_Stat_Total}" Margin="0,0,6,0" />
                        <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                                   Text="{Binding TotalCount}" Margin="0,0,16,0" />

                        <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc Conn_Stat_Blocked}" Margin="0,0,6,0" />
                        <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Danger}"
                                   Text="{Binding BlockedRuleCount}" Margin="0,0,16,0" />

                        <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc Conn_Stat_Unsynced}" Margin="0,0,6,0" />
                        <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Warning}"
                                   Text="{Binding UnsyncedCount}" />
                    </WrapPanel>

                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Caption}"
                               Foreground="{DynamicResource Brush.TextTertiary}"
                               VerticalAlignment="Center"
                               Text="{l:Loc Conn_ZeroOverhead_Hint}" />
                </Grid>
            </Border>
        </Grid>

        <!-- Modal Overlays (Block CIDR / Unblock Website / Blocked List / Blocked Apps / Manage Notes) -->
        <Grid Background="#99000000" Visibility="{Binding IsAnyModalOpen, Converter={StaticResource BoolToVisibility}}">
            <!-- 1. Block IP/CIDR Overlay -->
            <Border Style="{StaticResource Card}" Width="490" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource Brush.Popup}" BorderBrush="{DynamicResource Brush.ControlBorder}"
                    Visibility="{Binding IsBlockCidrModalOpen, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{l:Loc Conn_Modal_BlockCidr_Title}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc Conn_Modal_TargetLabel}" Margin="0,12,0,6" />
                    <TextBox Text="{Binding CustomCidrInput, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc Conn_Modal_NoteLabel}" Margin="0,10,0,6" />
                    <TextBox Text="{Binding CustomCidrNote, UpdateSourceTrigger=PropertyChanged}" />

                    <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,12,0,0"
                            Background="{DynamicResource Brush.DangerSubtle}" BorderBrush="{DynamicResource Brush.Danger}"
                            Visibility="{Binding CidrValidationError, Converter={StaticResource NullToVisibility}}">
                        <TextBox Style="{StaticResource TextBox.SelectableReadOnly}" Text="{Binding CidrValidationError, Mode=OneWay}" />
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,12,0,0"
                            Background="{DynamicResource Brush.WarningSubtle}" BorderBrush="{DynamicResource Brush.Warning}"
                            Visibility="{Binding PendingRiskWarning, Converter={StaticResource NullToVisibility}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextPrimary}"
                                       Text="{Binding PendingRiskWarning}" Margin="0,0,0,8" />
                            <CheckBox Style="{StaticResource Toggle.Switch}" IsChecked="{Binding IsRiskConfirmed}"
                                      Content="{l:Loc Conn_Modal_RiskAck}" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="{l:Loc Common_Cancel}" Command="{Binding CancelModalsCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource Button.Primary}" Content="{l:Loc Conn_Modal_AddBlock}"
                                Command="{Binding ConfirmBlockCidrCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 2. Unblock Website Overlay -->
            <Border Style="{StaticResource Card}" Width="490" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource Brush.Popup}" BorderBrush="{DynamicResource Brush.ControlBorder}"
                    Visibility="{Binding IsUnblockWebsiteModalOpen, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{l:Loc Conn_Modal_UnblockWeb_Title}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc Conn_Modal_DomainLabel}" Margin="0,12,0,6" />
                    <TextBox Text="{Binding UnblockDomainInput, UpdateSourceTrigger=PropertyChanged}" />

                    <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,12,0,0"
                            Background="{DynamicResource Brush.ControlFill}" BorderBrush="{DynamicResource Brush.ControlBorder}"
                            Visibility="{Binding UnblockWebsiteStatus, Converter={StaticResource NullToVisibility}}">
                        <TextBox Style="{StaticResource TextBox.SelectableReadOnly}" Text="{Binding UnblockWebsiteStatus, Mode=OneWay}" />
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="{l:Loc Common_Close}" Command="{Binding CancelModalsCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource Button.Primary}" Content="{l:Loc Conn_Modal_UnblockWeb_Action}"
                                Command="{Binding ExecuteUnblockWebsiteCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 3. Blocked IP/CIDR List Overlay -->
            <Border Style="{StaticResource Card}" Width="620" MaxHeight="520" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource Brush.Popup}" BorderBrush="{DynamicResource Brush.ControlBorder}"
                    Visibility="{Binding IsBlockedListModalOpen, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{l:Loc Conn_Modal_BlockedList_Title}" Margin="0,0,0,12" />

                    <ListBox Grid.Row="1" ItemsSource="{Binding ManagedBlockedRules}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" MaxHeight="340">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BlockedRuleItemViewModel}">
                                <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Style="{StaticResource Text.Mono}" FontWeight="SemiBold" Text="{Binding Target}" />
                                            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Note}"
                                                       Visibility="{Binding Note, Converter={StaticResource NullToVisibility}}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource Toggle.Switch}" IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                  Command="{Binding DataContext.ToggleBlockedRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding Target}" Margin="0,0,10,0" />
                                        <Button Grid.Column="2" Content="{l:Loc Conn_Modal_Remove}" Padding="10,4"
                                                Command="{Binding DataContext.RemoveBlockedRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Target}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="{l:Loc Conn_Modal_ClearAllFirewall}" Command="{Binding ClearAllFirewallRulesCommand}" />
                        <Button Grid.Column="2" Style="{StaticResource Button.Primary}" Content="{l:Loc Common_Close}"
                                Command="{Binding CancelModalsCommand}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- 4. Blocked Apps (.exe) List Overlay -->
            <Border Style="{StaticResource Card}" Width="660" MaxHeight="520" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource Brush.Popup}" BorderBrush="{DynamicResource Brush.ControlBorder}"
                    Visibility="{Binding IsBlockedAppsModalOpen, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{l:Loc Conn_Modal_BlockedApps_Title}" Margin="0,0,0,12" />

                    <ListBox Grid.Row="1" ItemsSource="{Binding ManagedBlockedApps}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" MaxHeight="340">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BlockedAppItemViewModel}">
                                <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="{Binding ProcessName}" />
                                            <TextBlock Style="{StaticResource Text.Mono}" FontSize="{DynamicResource Font.Size.Small}"
                                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                                       Text="{Binding ExecutablePath}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource Toggle.Switch}" IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                  Command="{Binding DataContext.ToggleBlockedAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding ExecutablePath}" Margin="0,0,10,0" />
                                        <Button Grid.Column="2" Content="{l:Loc Conn_Modal_Remove}" Padding="10,4"
                                                Command="{Binding DataContext.RemoveBlockedAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding ExecutablePath}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Style="{StaticResource Button.Primary}" Content="{l:Loc Common_Close}"
                                Command="{Binding CancelModalsCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 5. Manage Notes Overlay -->
            <Border Style="{StaticResource Card}" Width="600" MaxHeight="520" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource Brush.Popup}" BorderBrush="{DynamicResource Brush.ControlBorder}"
                    Visibility="{Binding IsNotesModalOpen, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{l:Loc Conn_Modal_Notes_Title}" Margin="0,0,0,12" />

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc Conn_Modal_IpKeyLabel}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding NoteEditorIp, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc Conn_Col_Note}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding NoteEditorText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource Button.Primary}" VerticalAlignment="Bottom"
                                Content="{l:Loc Conn_Modal_SaveNote}" Command="{Binding SaveNoteEntryCommand}" />
                    </Grid>

                    <ListBox Grid.Row="2" ItemsSource="{Binding ManagedNotes}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" MaxHeight="280">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:IpNoteItemViewModel}">
                                <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Style="{StaticResource Text.Mono}" FontWeight="SemiBold" Text="{Binding Ip}" />
                                            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Note}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{l:Loc Conn_Modal_Remove}" Padding="10,4"
                                                Command="{Binding DataContext.DeleteNoteEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Ip}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Style="{StaticResource Button.Primary}" Content="{l:Loc Common_Close}"
                                Command="{Binding CancelModalsCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
