<UserControl x:Class="JustCryptDns.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:JustCryptDns.App.ViewModels"
             xmlns:l="clr-namespace:JustCryptDns.App.Localization"
             xmlns:controls="clr-namespace:JustCryptDns.App.Controls"
             xmlns:ipc="clr-namespace:JustCryptDns.Core.Ipc;assembly=JustCryptDns.Core"
             xmlns:models="clr-namespace:JustCryptDns.Core.Models;assembly=JustCryptDns.Core"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}">
    <UserControl.Resources>
        <Style x:Key="KeyText" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="FontSize" Value="{DynamicResource Font.Size.BodyLarge}" />
        </Style>
        <Style x:Key="Cell" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,24,18" />
        </Style>
        <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="{DynamicResource Card.GapGrid}" />
            <Setter Property="Padding" Value="{DynamicResource Card.PaddingSmall}" />
        </Style>
        <Style x:Key="ChartCard" TargetType="Border" BasedOn="{StaticResource MetricCard}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.ControlBorderHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WaveCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="{DynamicResource Card.Gap}" />
            <Setter Property="Padding" Value="{DynamicResource Card.PaddingSmall}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.ControlBorderHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Button.EngineStatusAction" TargetType="Button" BasedOn="{StaticResource Button.Base}">
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="Background" Value="#FFD94248" />
            <Setter Property="BorderBrush" Value="#FFD94248" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Control}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FFE8545A" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#FFE8545A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FFC23339" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsEngineRunning}" Value="True">
                                <Setter Property="Background" Value="#FF169E60" />
                                <Setter Property="BorderBrush" Value="#FF169E60" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsEngineRunning}" Value="True" />
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Root" Property="Background" Value="#FF1DB871" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#FF1DB871" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsEngineRunning}" Value="True" />
                                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Root" Property="Background" Value="#FF12824E" />
                            </MultiDataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="32,4,32,32">
            <TextBlock Style="{StaticResource Text.PageTitle}" Text="{l:Loc Nav_Dashboard}" />
            <TextBlock Style="{StaticResource Text.Subtitle}" Text="{l:Loc Page_Dashboard_Subtitle}" Margin="0,4,0,22" />

            <!-- System Traffic Warning Banner (Non-53 port or Adapter DNS not pointing to local proxy) -->
            <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.WarningSubtle}" BorderBrush="{DynamicResource Brush.Warning}"
                    Padding="18,14" Margin="{DynamicResource Card.Gap}" Visibility="Collapsed"
                    controls:DismissBannerBehavior.BannerContent="{Binding TrafficWarningBanner}"
                    controls:DismissBannerBehavior.PersistKey="TrafficWarning"
                    controls:ChartHoverInfoBehavior.Title="{l:Loc Dash_Explain_TrafficWarn_Title}"
                    controls:ChartHoverInfoBehavior.Description="{l:Loc Dash_Explain_TrafficWarn_Desc}"
                    controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Dash_Explain_TrafficWarn_Metrics}"
                    controls:ChartHoverInfoBehavior.DelaySeconds="1.5">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7BA;" FontSize="18" Foreground="{DynamicResource Brush.Warning}" Margin="0,0,14,0" VerticalAlignment="Top" />
                        <TextBox Grid.Column="1" Style="{StaticResource TextBox.SelectableReadOnly}" Text="{Binding TrafficWarningBanner, Mode=OneWay}"
                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource Button.CopyInline}" controls:CopyTextBehavior.CopyText="{Binding TrafficWarningBanner}" />
                            <Button Style="{StaticResource Button.DismissInline}" Margin="4,0,0,0" controls:DismissBannerBehavior.IsDismissButton="True" />
                        </StackPanel>
                    </Grid>
                    <WrapPanel Orientation="Horizontal" Margin="32,12,0,0">
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding UseAlternateLoopbackPort53Command}" Margin="0,0,8,4"
                                Visibility="{Binding SuggestedLoopbackIp, Converter={StaticResource NullToVisibility}}">
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource LocFormat}" ConverterParameter="TrafficFix_UseLoopback53">
                                        <Binding Path="SuggestedLoopbackIp" />
                                        <Binding Path="Culture" Source="{x:Static l:LocalizationManager.Instance}" />
                                     </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Button>
                        <Button Command="{Binding StopConflictingServiceAndUsePort53Command}" Margin="0,0,8,4"
                                Visibility="{Binding ConflictingServiceName, Converter={StaticResource NullToVisibility}}">
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource LocFormat}" ConverterParameter="TrafficFix_StopService53">
                                        <Binding Path="ConflictingServiceName" />
                                        <Binding Path="Culture" Source="{x:Static l:LocalizationManager.Instance}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Button>
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding ApplyWindowsAdapterDnsNowCommand}"
                                Content="{l:Loc TrafficFix_ApplyAdapterDnsNow}" Margin="0,0,8,4"
                                Visibility="{Binding CanFixAdapterDns, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding PauseForCaptivePortalCommand}"
                                Content="{l:Loc Dns_PauseCaptivePortal}" Margin="0,0,8,4"
                                Visibility="{Binding CanPauseCaptivePortal, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding ResumeFromCaptivePortalCommand}"
                                Content="{l:Loc Dns_ResumeCaptivePortal}" Margin="0,0,8,4"
                                Visibility="{Binding IsCaptivePortalPaused, Converter={StaticResource BoolToVisibility}}" />
                        <Button Command="{Binding TestLocalProxyCommand}" Content="{l:Loc DnsMgr_TestLocalProxy}" Margin="0,0,8,4" />
                        <Button Command="{Binding OpenDnsManagerCommand}" Content="{l:Loc Nav_DnsManager}" Margin="0,0,0,4" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Unencrypted DNS Warning Banner -->
            <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.WarningSubtle}" BorderBrush="{DynamicResource Brush.Warning}"
                    Padding="18,14" Margin="{DynamicResource Card.Gap}" Visibility="Collapsed"
                    controls:DismissBannerBehavior.BannerContent="{Binding IsUnencryptedDnsActive}"
                    controls:DismissBannerBehavior.PersistKey="UnencryptedDns">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7BA;" FontSize="18" Foreground="{DynamicResource Brush.Warning}" Margin="0,0,14,0" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Text="{l:Loc DnsWarn_UnencryptedActive}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Grid.Column="2" Style="{StaticResource Button.DismissInline}" controls:DismissBannerBehavior.IsDismissButton="True" />
                    </Grid>
                    <WrapPanel Orientation="Horizontal" Margin="32,12,0,0">
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding SwitchToEncryptedDnsCommand}"
                                Content="{l:Loc DnsWarn_SwitchToEncryptedDoh}" Margin="0,0,8,4" />
                        <Button Command="{Binding OpenDnsManagerCommand}" Content="{l:Loc Nav_DnsManager}" Margin="0,0,0,4" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Error Banner -->
            <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.DangerSubtle}" BorderBrush="{DynamicResource Brush.Danger}"
                    Padding="16,12" Margin="{DynamicResource Card.Gap}" Visibility="Collapsed"
                    controls:DismissBannerBehavior.BannerContent="{Binding EngineError}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource TextBox.SelectableReadOnly}" Text="{Binding EngineError, Mode=OneWay}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource Button.CopyInline}" controls:CopyTextBehavior.CopyText="{Binding EngineError}" />
                        <Button Style="{StaticResource Button.DismissInline}" Margin="4,0,0,0" controls:DismissBannerBehavior.IsDismissButton="True" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Local Proxy Test Feedback Banner -->
            <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.SuccessSubtle}" BorderBrush="{DynamicResource Brush.Success}"
                    Padding="16,12" Margin="{DynamicResource Card.Gap}" Visibility="Collapsed"
                    controls:DismissBannerBehavior.BannerContent="{Binding TestProxyFeedback}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource TextBox.SelectableReadOnly}" Text="{Binding TestProxyFeedback, Mode=OneWay}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource Button.CopyInline}" controls:CopyTextBehavior.CopyText="{Binding TestProxyFeedback}" />
                        <Button Style="{StaticResource Button.DismissInline}" Margin="4,0,0,0" controls:DismissBannerBehavior.IsDismissButton="True" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Protection status -->
            <Border Style="{StaticResource Card}" Margin="{DynamicResource Card.Gap}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="ShieldContainer" Width="60" Height="60" VerticalAlignment="Top" Background="Transparent"
                          controls:ChartHoverInfoBehavior.Title="{l:Loc Dash_Protection_Title}"
                          controls:ChartHoverInfoBehavior.Description="{l:Loc Dash_Explain_Shield_Desc}"
                          controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Dash_Explain_Shield_Metrics}"
                          controls:ChartHoverInfoBehavior.DelaySeconds="1.5">
                        <Ellipse x:Name="ShieldHaloRing" Width="56" Height="56" StrokeThickness="2.2" Opacity="0"
                                 IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="ShieldHaloScale" ScaleX="1" ScaleY="1" />
                            </Ellipse.RenderTransform>
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Stroke" Value="{DynamicResource Brush.Danger}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEngineRunning}" Value="True">
                                            <Setter Property="Stroke" Value="{DynamicResource Brush.Success}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>

                        <Border x:Name="ShieldBadge" Width="56" Height="56" CornerRadius="28" IsHitTestVisible="False">
                            <Border.Effect>
                                <DropShadowEffect x:Name="ShieldGlowEffect" ShadowDepth="0" BlurRadius="16" Opacity="0" />
                            </Border.Effect>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Brush.DangerSubtle}" />
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Danger}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEngineRunning}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.SuccessSubtle}" />
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Success}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xEA18;" FontSize="24"
                                       Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}" />
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="18,0,24,0" VerticalAlignment="Center" Background="Transparent"
                                controls:ChartHoverInfoBehavior.Title="{l:Loc Dash_Protection_Title}"
                                controls:ChartHoverInfoBehavior.Description="{l:Loc Dash_Explain_ProtectionStatus_Desc}"
                                controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Dash_Explain_ProtectionStatus_Metrics}"
                                controls:ChartHoverInfoBehavior.DelaySeconds="1.5">
                        <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc Dash_Protection_Title}" IsHitTestVisible="False" />
                        <TextBlock FontSize="{DynamicResource Font.Size.Hero}" FontWeight="SemiBold" Margin="0,2,0,4"
                                   FontFamily="{StaticResource Font.Display}" TextWrapping="Wrap" IsHitTestVisible="False">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource LocKey}">
                                    <Binding Path="ProtectionStatusLocKey" />
                                    <Binding Path="Culture" Source="{x:Static l:LocalizationManager.Instance}" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock MaxWidth="560" HorizontalAlignment="Left" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                    <Setter Property="Text" Value="{l:Loc Dash_Protection_StoppedDetail}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEngineRunning}" Value="True">
                                            <Setter Property="Text" Value="{l:Loc Dash_Protection_RunningDetail}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <Border x:Name="EngineButtonHalo" Margin="-3" CornerRadius="9" BorderThickness="2" Opacity="0"
                                IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="EngineButtonHaloScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEngineRunning}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <Button x:Name="ToggleEngineButton" Style="{StaticResource Button.EngineStatusAction}" Padding="20,10"
                                Command="{Binding ToggleEngineCommand}"
                                controls:ChartHoverInfoBehavior.Title="{l:Loc Dash_Explain_ToggleDns_Title}"
                                controls:ChartHoverInfoBehavior.Description="{l:Loc Dash_Explain_ToggleDns_Desc}"
                                controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Dash_Explain_ToggleDns_Metrics}"
                                controls:ChartHoverInfoBehavior.DelaySeconds="1.5">
                            <Button.Effect>
                                <DropShadowEffect x:Name="EngineButtonGlow" ShadowDepth="0" BlurRadius="14" Opacity="0" />
                            </Button.Effect>
                            <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                <TextBlock FontSize="13" Margin="0,0,8,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Icon}">
                                            <Setter Property="Text" Value="&#xE768;" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEngineRunning}" Value="True">
                                                    <Setter Property="Text" Value="&#xE71A;" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{l:Loc Dash_StartEngine}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEngineRunning}" Value="True">
                                                    <Setter Property="Text" Value="{l:Loc DnsMgr_StopEngine}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <UniformGrid Grid.Row="1" Grid.ColumnSpan="3" Rows="1" Margin="0,22,0,0">
                        <StackPanel Background="Transparent"
                                    controls:ChartHoverInfoBehavior.Title="{l:Loc Dash_Protocol}"
                                    controls:ChartHoverInfoBehavior.Description="{l:Loc Dash_Explain_Protocol_Desc}"
                                    controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Dash_Explain_Protocol_Metrics}"
                                    controls:ChartHoverInfoBehavior.DelaySeconds="1.5">
                            <TextBlock Style="{StaticResource KeyText}" Text="{l:Loc Dash_Protocol}" IsHitTestVisible="False" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding ActiveProtocol}" IsHitTestVisible="False" />
                        </StackPanel>
                        <StackPanel Background="Transparent"
                                    controls:ChartHoverInfoBehavior.Title="{l:Loc Dash_Resolver}"
                                    controls:ChartHoverInfoBehavior.Description="{l:Loc Dash_Explain_Resolver_Desc}"
                                    controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Dash_Explain_Resolver_Metrics}"
                                    controls:ChartHoverInfoBehavior.DelaySeconds="1.5">
                            <TextBlock Style="{StaticResource KeyText}" Text="{l:Loc Dash_Resolver}" IsHitTestVisible="False" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding ActiveResolverName}" IsHitTestVisible="False" />
                        </StackPanel>
                        <StackPanel Background="Transparent"
                                    controls:ChartHoverInfoBehavior.Title="{l:Loc DnsMgr_LocalProxy}"
                                    controls:ChartHoverInfoBehavior.Description="{l:Loc Dash_Explain_LocalProxy_Desc}"
                                    controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Dash_Explain_LocalProxy_Metrics}"
                                    controls:ChartHoverInfoBehavior.DelaySeconds="1.5">
                            <TextBlock Style="{StaticResource KeyText}" Text="{l:Loc DnsMgr_LocalProxy}" IsHitTestVisible="False" />
                            <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding ListenEndpoint}" IsHitTestVisible="False" />
                        </StackPanel>
                        <StackPanel Background="Transparent"
                                    controls:ChartHoverInfoBehavior.Title="{l:Loc Dash_Filtering}"
                                    controls:ChartHoverInfoBehavior.Description="{l:Loc Dash_Explain_Filtering_Desc}"
                                    controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Dash_Explain_Filtering_Metrics}"
                                    controls:ChartHoverInfoBehavior.DelaySeconds="1.5">
                            <TextBlock Style="{StaticResource KeyText}" Text="{l:Loc Dash_Filtering}" IsHitTestVisible="False" />
                            <TextBlock IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ValueText}">
                                        <Setter Property="Text" Value="{l:Loc Animations_Off}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFilteringActive}" Value="True">
                                                <Setter Property="Text" Value="{l:Loc Filtering_Stat_Active}" />
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- Engine & Network Stability metrics (5 live automotive speedometer gauges) -->
            <UniformGrid x:Name="Metrics" Margin="{DynamicResource Card.GridCompensation}"
                         Columns="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource WidthToFiveColumns}}">
                <Border Style="{StaticResource ChartCard}"
                        controls:ChartHoverInfoBehavior.Title="{l:Loc Dash_Metric_Latency}"
                        controls:ChartHoverInfoBehavior.Description="{l:Loc Dash_Explain_Latency_Desc}"
                        controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Dash_Explain_Latency_Metrics}">
                    <StackPanel IsHitTestVisible="False">
                        <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc Dash_Metric_Latency}" HorizontalAlignment="Center" />
                        <controls:SpeedometerGaugeControl x:Name="LatencyGauge" Height="142" Margin="0,4,0,2"
                                                          Value="{Binding LatencyMsValue}"
                                                          Minimum="0"
                                                          Maximum="{Binding LatencyMaxScale}"
                                                          ValueText="{Binding LatencyDisplay}"
                                                          MaxScaleLabel="{Binding LatencyScaleLabel}"
                                                          ShowRedlineZone="True"
                                                          PhaseOffset="0.0"
                                                          IsActive="{Binding IsEngineRunning}"
                                                          TrackBrush="{DynamicResource Brush.Divider}"
                                                          TextBrush="{DynamicResource Brush.TextPrimary}"
                                                          SecondaryTextBrush="{DynamicResource Brush.TextTertiary}"
                                                          DangerBrush="{DynamicResource Brush.Danger}"
                                                          FaceBrush="{DynamicResource Brush.ControlFill}"
                                                          BorderBrush="{DynamicResource Brush.CardBorder}">
                            <controls:SpeedometerGaugeControl.Style>
                                <Style TargetType="controls:SpeedometerGaugeControl">
                                    <Setter Property="AccentBrush" Value="{DynamicResource Brush.Accent}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LatencySeverity}" Value="{x:Static controls:GaugeSeverity.Good}">
                                            <Setter Property="AccentBrush" Value="{DynamicResource Brush.Success}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LatencySeverity}" Value="{x:Static controls:GaugeSeverity.Warning}">
                                            <Setter Property="AccentBrush" Value="{DynamicResource Brush.Warning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LatencySeverity}" Value="{x:Static controls:GaugeSeverity.Danger}">
                                            <Setter Property="AccentBrush" Value="{DynamicResource Brush.Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:SpeedometerGaugeControl.Style>
                        </controls:SpeedometerGaugeControl>
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding ActiveResolverName}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ChartCard}"
                        controls:ChartHoverInfoBehavior.Title="{l:Loc Dash_Metric_Queries}"
                        controls:ChartHoverInfoBehavior.Description="{l:Loc Dash_Explain_Queries_Desc}"
                        controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Dash_Explain_Queries_Metrics}">
                    <StackPanel IsHitTestVisible="False">
                        <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc Dash_Metric_Queries}" HorizontalAlignment="Center" />
                        <controls:SpeedometerGaugeControl x:Name="QueriesGauge" Height="142" Margin="0,4,0,2"
                                                          Value="{Binding TotalQueriesValue}"
                                                          Minimum="0"
                                                          Maximum="{Binding TotalQueriesMaxScale}"
                                                          ValueText="{Binding TotalQueriesDisplay}"
                                                          MaxScaleLabel="{Binding TotalQueriesScaleLabel}"
                                                          PhaseOffset="1.5"
                                                          IsActive="{Binding IsEngineRunning}"
                                                          AccentBrush="{DynamicResource Brush.Accent}"
                                                          TrackBrush="{DynamicResource Brush.Divider}"
                                                          TextBrush="{DynamicResource Brush.TextPrimary}"
                                                          SecondaryTextBrush="{DynamicResource Brush.TextTertiary}"
                                                          DangerBrush="{DynamicResource Brush.Danger}"
                                                          FaceBrush="{DynamicResource Brush.ControlFill}"
                                                          BorderBrush="{DynamicResource Brush.CardBorder}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding ListenEndpoint}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ChartCard}"
                        controls:ChartHoverInfoBehavior.Title="{l:Loc Dash_Metric_Blocked}"
                        controls:ChartHoverInfoBehavior.Description="{l:Loc Dash_Explain_Blocked_Desc}"
                        controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Dash_Explain_Blocked_Metrics}">
                    <StackPanel IsHitTestVisible="False">
                        <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc Dash_Metric_Blocked}" HorizontalAlignment="Center" />
                        <controls:SpeedometerGaugeControl x:Name="BlockedGauge" Height="142" Margin="0,4,0,2"
                                                          Value="{Binding BlockedQueriesValue}"
                                                          Minimum="0"
                                                          Maximum="{Binding BlockedQueriesMaxScale}"
                                                          ValueText="{Binding BlockedQueriesDisplay}"
                                                          MaxScaleLabel="{Binding BlockedQueriesScaleLabel}"
                                                          PhaseOffset="3.1"
                                                          IsActive="{Binding IsEngineRunning}"
                                                          AccentBrush="{DynamicResource Brush.Danger}"
                                                          TrackBrush="{DynamicResource Brush.Divider}"
                                                          TextBrush="{DynamicResource Brush.TextPrimary}"
                                                          SecondaryTextBrush="{DynamicResource Brush.TextTertiary}"
                                                          DangerBrush="{DynamicResource Brush.Danger}"
                                                          FaceBrush="{DynamicResource Brush.ControlFill}"
                                                          BorderBrush="{DynamicResource Brush.CardBorder}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc Nav_Filtering}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ChartCard}"
                        controls:ChartHoverInfoBehavior.Title="{l:Loc Dash_Metric_CacheHit}"
                        controls:ChartHoverInfoBehavior.Description="{l:Loc Dash_Explain_CacheHit_Desc}"
                        controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Dash_Explain_CacheHit_Metrics}">
                    <StackPanel IsHitTestVisible="False">
                        <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc Dash_Metric_CacheHit}" HorizontalAlignment="Center" />
                        <controls:SpeedometerGaugeControl x:Name="CacheHitGauge" Height="142" Margin="0,4,0,2"
                                                          Value="{Binding CacheHitPercentValue}"
                                                          Minimum="0"
                                                          Maximum="100"
                                                          ValueText="{Binding CacheHitDisplay}"
                                                          MaxScaleLabel="100%"
                                                          PhaseOffset="4.6"
                                                          IsActive="{Binding IsEngineRunning}"
                                                          TrackBrush="{DynamicResource Brush.Divider}"
                                                          TextBrush="{DynamicResource Brush.TextPrimary}"
                                                          SecondaryTextBrush="{DynamicResource Brush.TextTertiary}"
                                                          DangerBrush="{DynamicResource Brush.Danger}"
                                                          FaceBrush="{DynamicResource Brush.ControlFill}"
                                                          BorderBrush="{DynamicResource Brush.CardBorder}">
                            <controls:SpeedometerGaugeControl.Style>
                                <Style TargetType="controls:SpeedometerGaugeControl">
                                    <Setter Property="AccentBrush" Value="{DynamicResource Brush.Accent}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CacheHitSeverity}" Value="{x:Static controls:GaugeSeverity.Good}">
                                            <Setter Property="AccentBrush" Value="{DynamicResource Brush.Success}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CacheHitSeverity}" Value="{x:Static controls:GaugeSeverity.Warning}">
                                            <Setter Property="AccentBrush" Value="{DynamicResource Brush.Warning}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:SpeedometerGaugeControl.Style>
                        </controls:SpeedometerGaugeControl>
                        <TextBlock Style="{StaticResource Text.Caption}" Text="TTL Cache" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ChartCard}"
                        controls:ChartHoverInfoBehavior.Title="{l:Loc Dash_Metric_Stability}"
                        controls:ChartHoverInfoBehavior.Description="{l:Loc Dash_Explain_Stability_Desc}"
                        controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Dash_Explain_Stability_Metrics}">
                    <StackPanel IsHitTestVisible="False">
                        <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc Dash_Metric_Stability}" HorizontalAlignment="Center" />
                        <controls:SpeedometerGaugeControl x:Name="StabilityGauge" Height="142" Margin="0,4,0,2"
                                                          Value="{Binding NetworkStabilityPercentValue}"
                                                          Minimum="0"
                                                          Maximum="100"
                                                          ValueText="{Binding NetworkStabilityDisplay}"
                                                          MaxScaleLabel="100%"
                                                          PhaseOffset="6.1"
                                                          IsActive="{Binding IsTelemetryActive}"
                                                          TrackBrush="{DynamicResource Brush.Divider}"
                                                          TextBrush="{DynamicResource Brush.TextPrimary}"
                                                          SecondaryTextBrush="{DynamicResource Brush.TextTertiary}"
                                                          DangerBrush="{DynamicResource Brush.Danger}"
                                                          FaceBrush="{DynamicResource Brush.ControlFill}"
                                                          BorderBrush="{DynamicResource Brush.CardBorder}">
                            <controls:SpeedometerGaugeControl.Style>
                                <Style TargetType="controls:SpeedometerGaugeControl">
                                    <Setter Property="AccentBrush" Value="{DynamicResource Brush.Accent}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StabilitySeverity}" Value="{x:Static controls:GaugeSeverity.Good}">
                                            <Setter Property="AccentBrush" Value="{DynamicResource Brush.Success}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StabilitySeverity}" Value="{x:Static controls:GaugeSeverity.Warning}">
                                            <Setter Property="AccentBrush" Value="{DynamicResource Brush.Warning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StabilitySeverity}" Value="{x:Static controls:GaugeSeverity.Danger}">
                                            <Setter Property="AccentBrush" Value="{DynamicResource Brush.Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:SpeedometerGaugeControl.Style>
                        </controls:SpeedometerGaugeControl>
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding PacketLossSummaryDisplay}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Seamless 5-Mode Operation Switcher Bar + Inline Per-Mode Customizer -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,12">
                <StackPanel>
                    <controls:OperationModeSwitcherControl x:Name="ModeSwitcher"
                                                           SelectedMode="{Binding SelectedOperationMode, Mode=TwoWay}"
                                                           EffectiveMode="{Binding EffectiveOperationMode}"
                                                           MinimizeVisualEffects="{Binding MinimizeVisualEffects}"
                                                           ModeSelectedCommand="{Binding SelectOperationModeCommand}" />

                    <!-- Live Mode Description + Customize Toggle -->
                    <Grid Margin="2,10,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE946;" FontSize="13" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource Text.Caption}"
                                       Text="{Binding OperationModeSummaryText}"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Style="{StaticResource Button.Subtle}"
                                Padding="10,5"
                                Margin="12,0,0,0"
                                Command="{Binding ToggleModeCustomizerCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE713;" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{l:Loc Mode_Customize}" FontSize="{DynamicResource Font.Size.Small}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Collapsible Per-Mode Customizer Drawer -->
                    <Border Margin="0,12,0,0"
                            Padding="14,12"
                            CornerRadius="10"
                            Background="{DynamicResource Brush.ControlFill}"
                            BorderBrush="{DynamicResource Brush.CardBorder}"
                            BorderThickness="1"
                            Visibility="{Binding IsModeCustomizerOpen, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{l:Loc Mode_Custom_Header}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Style="{StaticResource Button.Subtle}"
                                            Padding="10,5"
                                            Margin="0,0,8,0"
                                            Command="{Binding ResetCurrentModeToDefaultCommand}">
                                        <TextBlock Text="{l:Loc Mode_Custom_Reset}" FontSize="{DynamicResource Font.Size.Small}" />
                                    </Button>
                                    <Button Style="{StaticResource Button.Primary}"
                                            Padding="12,5"
                                            Command="{Binding SaveModeCustomizationCommand}">
                                        <TextBlock Text="{l:Loc Mode_Custom_Save}" FontSize="{DynamicResource Font.Size.Small}" FontWeight="SemiBold" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Concrete Mode Customization (HighSpeed / Gaming / Balanced / Security) -->
                            <StackPanel Visibility="{Binding IsEditingConcreteMode, Converter={StaticResource BoolToVisibility}}">
                                <UniformGrid Columns="3" Margin="0,0,0,10">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc Mode_Custom_PrimaryResolver}" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding AvailableModeResolvers}"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{Binding EditModeResolverId, Mode=TwoWay}"
                                                  DisplayMemberPath="Name" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc Mode_Custom_SecondaryResolver}" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding AvailableModeResolvers}"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{Binding EditModeSecondaryResolverId, Mode=TwoWay}"
                                                  DisplayMemberPath="Name" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc Mode_Custom_Monitoring}" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding AvailableMonitoringModes}"
                                                  SelectedItem="{Binding EditModeMonitoringMode, Mode=TwoWay}" />
                                    </StackPanel>
                                </UniformGrid>

                                <UniformGrid Columns="2" Margin="0,0,0,10">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc Mode_Custom_TimeoutMs}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding EditModeQueryTimeoutMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc Mode_Custom_CacheSize}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding EditModeCacheMaxEntries, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>

                                <UniformGrid Columns="3">
                                    <CheckBox Content="{l:Loc Mode_Custom_EnableFiltering}" IsChecked="{Binding EditModeEnableFiltering, Mode=TwoWay}" Margin="0,3,8,3" />
                                    <CheckBox Content="{l:Loc Mode_Custom_AllBlocklists}" IsChecked="{Binding EditModeEnableAllBuiltInBlocklists, Mode=TwoWay}" Margin="0,3,8,3" />
                                    <CheckBox Content="{l:Loc Mode_Custom_GamingEngine}" IsChecked="{Binding EditModeEnableGamingEngine, Mode=TwoWay}" Margin="0,3,8,3" />
                                    <CheckBox Content="{l:Loc Mode_Custom_ForceEncrypted}" IsChecked="{Binding EditModeForceEncryptedOnly, Mode=TwoWay}" Margin="0,3,8,3" />
                                    <CheckBox Content="{l:Loc Mode_Custom_Prefetch}" IsChecked="{Binding EditModeEnableCachePrefetch, Mode=TwoWay}" Margin="0,3,8,3" />
                                    <CheckBox Content="{l:Loc Mode_Custom_ServeStale}" IsChecked="{Binding EditModeEnableServeStale, Mode=TwoWay}" Margin="0,3,8,3" />
                                    <CheckBox Content="{l:Loc Mode_Custom_DnsLeakGuard}" IsChecked="{Binding EditModeEnableDnsLeakGuard, Mode=TwoWay}" Margin="0,3,8,3" />
                                    <CheckBox Content="{l:Loc Mode_Custom_ThreatIntel}" IsChecked="{Binding EditModeEnableThreatIntelligence, Mode=TwoWay}" Margin="0,3,8,3" />
                                    <CheckBox Content="{l:Loc Mode_Custom_AutoBlockThreat}" IsChecked="{Binding EditModeAutoBlockDetectedThreats, Mode=TwoWay}" Margin="0,3,8,3" />
                                    <CheckBox Content="{l:Loc Mode_Custom_VerifySig}" IsChecked="{Binding EditModeVerifyProcessSignatures, Mode=TwoWay}" Margin="0,3,8,3" />
                                    <CheckBox Content="{l:Loc Mode_Custom_FirefoxCanary}" IsChecked="{Binding EditModeBlockFirefoxDohCanary, Mode=TwoWay}" Margin="0,3,8,3" />
                                    <CheckBox Content="{l:Loc Mode_Custom_MinimizeFx}" IsChecked="{Binding EditModeMinimizeVisualEffects, Mode=TwoWay}" Margin="0,3,8,3" />
                                </UniformGrid>
                            </StackPanel>

                            <!-- Auto Mode Rules Customization -->
                            <StackPanel Visibility="{Binding IsEditingAutoMode, Converter={StaticResource BoolToVisibility}}">
                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                    <CheckBox Content="{l:Loc Mode_Auto_Opt_FullscreenGame}" IsChecked="{Binding EditAutoSwitchGaming, Mode=TwoWay}" Margin="0,3,10,3" />
                                    <CheckBox Content="{l:Loc Mode_Auto_Opt_ThreatSpike}" IsChecked="{Binding EditAutoSwitchSecurity, Mode=TwoWay}" Margin="0,3,0,3" />
                                </UniformGrid>
                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc Mode_Auto_Opt_BlockThreshold}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding EditAutoHighBlockThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc Mode_Auto_Opt_Cooldown}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding EditAutoCooldownSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc Mode_Auto_Opt_CustomGames}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding EditAutoCustomGamesCsv, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Margin="0,8,0,0"
                                       Style="{StaticResource Text.Caption}"
                                       Foreground="{DynamicResource Brush.Success}"
                                       Text="{Binding ModeCustomizerFeedback}"
                                       Visibility="{Binding ModeCustomizerFeedback, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Live Ping & Network Speed Waveform Gauge -->
            <Border Style="{StaticResource WaveCard}"
                    controls:ChartHoverInfoBehavior.Title="{l:Loc Dash_Wave_Title}"
                    controls:ChartHoverInfoBehavior.Description="{l:Loc Dash_Explain_Wave_Desc}"
                    controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Dash_Explain_Wave_Metrics}">
                <StackPanel IsHitTestVisible="False">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE9D2;" FontSize="15" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,8,0" />
                            <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{l:Loc Dash_Wave_Title}" VerticalAlignment="Center" />
                            <Border Margin="10,0,0,0">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                        <Setter Property="Background" Value="{DynamicResource Brush.SuccessSubtle}" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Success}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTelemetryPaused}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Brush.WarningSubtle}" />
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Warning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"
                                             Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}" />
                                    <TextBlock FontSize="{DynamicResource Font.Size.Small}" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{l:Loc Dash_Wave_Live}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTelemetryPaused}" Value="True">
                                                        <Setter Property="Text" Value="{l:Loc Dash_Wave_Paused}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,2,14,2" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Warning}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc Dash_Wave_Ping}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding PingDisplay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,2,14,2" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Accent}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc Dash_Wave_Download}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding DownloadSpeedDisplay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,2,0,2" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Success}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc Dash_Wave_Upload}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding UploadSpeedDisplay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </WrapPanel>
                    </Grid>

                    <controls:NetworkTelemetryWaveControl x:Name="TelemetryWave" Height="168" Margin="0,12,0,6"
                                                      PingBrush="{DynamicResource Brush.Warning}"
                                                      DownloadBrush="{DynamicResource Brush.Accent}"
                                                      UploadBrush="{DynamicResource Brush.Success}"
                                                      GridBrush="{DynamicResource Brush.Divider}"
                                                      SurfaceBrush="{DynamicResource Brush.ControlFill}"
                                                      BorderBrush="{DynamicResource Brush.CardBorder}"
                                                      TextBrush="{DynamicResource Brush.TextPrimary}"
                                                      SecondaryTextBrush="{DynamicResource Brush.TextTertiary}"
                                                      IsPaused="{Binding IsTelemetryPaused}" />

                    <TextBlock Style="{StaticResource Text.Caption}" FontSize="{DynamicResource Font.Size.Small}"
                               Foreground="{DynamicResource Brush.TextTertiary}" Text="{l:Loc Dash_Wave_HoverHint}" />
                </StackPanel>
            </Border>

            <!-- DPI Bypass & Firewall Protection Card -->
            <Border Style="{StaticResource Card}" Margin="{DynamicResource Card.Gap}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Width="42" Height="42" CornerRadius="21" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Brush.NeutralSubtle}" />
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Neutral}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BypassState}" Value="{x:Static models:BypassEngineState.Running}">
                                        <Setter Property="Background" Value="{DynamicResource Brush.SuccessSubtle}" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Success}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BypassState}" Value="{x:Static models:BypassEngineState.Degraded}">
                                        <Setter Property="Background" Value="{DynamicResource Brush.WarningSubtle}" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Warning}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE705;" FontSize="18"
                                   Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center" Background="Transparent"
                                controls:ChartHoverInfoBehavior.Title="{l:Loc Dash_Bypass_Title}"
                                controls:ChartHoverInfoBehavior.Description="{l:Loc Dash_Explain_BypassStatus_Desc}"
                                controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Dash_Explain_BypassStatus_Metrics}"
                                controls:ChartHoverInfoBehavior.DelaySeconds="1.5">
                        <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc Dash_Bypass_Title}" IsHitTestVisible="False" />
                        <TextBlock Style="{StaticResource Text.SectionTitle}" Margin="0,2,0,2" IsHitTestVisible="False">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource LocKey}" ConverterParameter="BypassState_">
                                    <Binding Path="BypassState" />
                                    <Binding Path="Culture" Source="{x:Static l:LocalizationManager.Instance}" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc Dash_Bypass_Desc}" IsHitTestVisible="False" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding OpenBypassCommand}" Content="{l:Loc Dash_Bypass_Configure}" Margin="0,0,8,0"
                                controls:ChartHoverInfoBehavior.Title="{l:Loc Dash_Bypass_Configure}"
                                controls:ChartHoverInfoBehavior.Description="{l:Loc Dash_Explain_ConfigureBypass_Desc}"
                                controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Dash_Explain_ConfigureBypass_Metrics}"
                                controls:ChartHoverInfoBehavior.DelaySeconds="1.5" />
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding ToggleBypassCommand}"
                                controls:ChartHoverInfoBehavior.Title="{l:Loc Dash_Explain_ToggleBypass_Title}"
                                controls:ChartHoverInfoBehavior.Description="{l:Loc Dash_Explain_ToggleBypass_Desc}"
                                controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Dash_Explain_ToggleBypass_Metrics}"
                                controls:ChartHoverInfoBehavior.DelaySeconds="1.5">
                            <TextBlock IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{l:Loc Bypass_StartEngine}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBypassRunning}" Value="True">
                                                <Setter Property="Text" Value="{l:Loc Bypass_StopEngine}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </StackPanel>

                    <UniformGrid Grid.Row="1" Grid.ColumnSpan="3" Rows="1" Margin="0,16,0,0">
                        <StackPanel Background="Transparent"
                                    controls:ChartHoverInfoBehavior.Title="{l:Loc Bypass_ProxyEndpoint}"
                                    controls:ChartHoverInfoBehavior.Description="{l:Loc Dash_Explain_BypassEndpoint_Desc}"
                                    controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Dash_Explain_BypassEndpoint_Metrics}"
                                    controls:ChartHoverInfoBehavior.DelaySeconds="1.5">
                            <TextBlock Style="{StaticResource KeyText}" Text="{l:Loc Bypass_ProxyEndpoint}" IsHitTestVisible="False" />
                            <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding BypassEndpoint}" IsHitTestVisible="False" />
                        </StackPanel>
                        <StackPanel Background="Transparent"
                                    controls:ChartHoverInfoBehavior.Title="{l:Loc Bypass_CoverageMode}"
                                    controls:ChartHoverInfoBehavior.Description="{l:Loc Dash_Explain_CoverageMode_Desc}"
                                    controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Dash_Explain_CoverageMode_Metrics}"
                                    controls:ChartHoverInfoBehavior.DelaySeconds="1.5">
                            <TextBlock Style="{StaticResource KeyText}" Text="{l:Loc Bypass_CoverageMode}" IsHitTestVisible="False" />
                            <TextBlock Style="{StaticResource ValueText}" IsHitTestVisible="False">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource LocKey}" ConverterParameter="CoverageMode_">
                                        <Binding Path="BypassCoverageMode" />
                                        <Binding Path="Culture" Source="{x:Static l:LocalizationManager.Instance}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Background="Transparent"
                                    controls:ChartHoverInfoBehavior.Title="{l:Loc Bypass_Metric_DpiBypassed}"
                                    controls:ChartHoverInfoBehavior.Description="{l:Loc Dash_Explain_DpiBypassed_Desc}"
                                    controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Dash_Explain_DpiBypassed_Metrics}"
                                    controls:ChartHoverInfoBehavior.DelaySeconds="1.5">
                            <TextBlock Style="{StaticResource KeyText}" Text="{l:Loc Bypass_Metric_DpiBypassed}" IsHitTestVisible="False" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding BypassDpiCountDisplay}" IsHitTestVisible="False" />
                        </StackPanel>
                        <StackPanel Background="Transparent"
                                    controls:ChartHoverInfoBehavior.Title="{l:Loc Dash_Bypass_Tunneled}"
                                    controls:ChartHoverInfoBehavior.Description="{l:Loc Dash_Explain_Tunneled_Desc}"
                                    controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Dash_Explain_Tunneled_Metrics}"
                                    controls:ChartHoverInfoBehavior.DelaySeconds="1.5">
                            <TextBlock Style="{StaticResource KeyText}" Text="{l:Loc Dash_Bypass_Tunneled}" IsHitTestVisible="False" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding BypassTunnelCountDisplay}" IsHitTestVisible="False" />
                        </StackPanel>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- Compact Network Card (Left) + Live Running DNS Query Log Card (Right) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4.3*" />
                    <ColumnDefinition Width="5.7*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Compact Network adapter status -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20,16" Margin="0,0,7,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Background="Transparent" Margin="0,0,8,0"
                                        controls:ChartHoverInfoBehavior.Title="{l:Loc Dash_Network_Title}"
                                        controls:ChartHoverInfoBehavior.Description="{l:Loc Dash_Explain_NetworkStatus_Desc}"
                                        controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Dash_Explain_NetworkStatus_Metrics}"
                                        controls:ChartHoverInfoBehavior.DelaySeconds="1.5">
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,3" IsHitTestVisible="False">
                                    <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{l:Loc Dash_Network_Title}" VerticalAlignment="Center" Margin="0,0,8,2" />

                                    <Border Margin="0,0,0,2" Visibility="{Binding HasSnapshot, Converter={StaticResource BoolToVisibility}}">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                                <Setter Property="Background" Value="{DynamicResource Brush.DangerSubtle}" />
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Danger}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Connectivity}" Value="{x:Static models:LocalConnectivity.LocalOnly}">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.WarningSubtle}" />
                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Warning}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Connectivity}" Value="{x:Static models:LocalConnectivity.GatewayAvailable}">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.SuccessSubtle}" />
                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Success}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"
                                                     Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}" />
                                            <TextBlock FontSize="{DynamicResource Font.Size.Small}" FontWeight="SemiBold">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource LocKey}" ConverterParameter="Connectivity_">
                                                        <Binding Path="Connectivity" />
                                                        <Binding Path="Culture" Source="{x:Static l:LocalizationManager.Instance}" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Text.Caption}" FontSize="{DynamicResource Font.Size.Small}"
                                           Foreground="{DynamicResource Brush.TextTertiary}" IsHitTestVisible="False">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LocFormat}" ConverterParameter="Dash_Network_Updated">
                                            <Binding Path="LastUpdated" />
                                            <Binding Path="Culture" Source="{x:Static l:LocalizationManager.Instance}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>

                            <Button Grid.Column="1" Style="{StaticResource Button.Subtle}" Command="{Binding RefreshCommand}" Padding="8,6"
                                    VerticalAlignment="Top"
                                    AutomationProperties.Name="{l:Loc Common_Refresh}"
                                    controls:ChartHoverInfoBehavior.Title="{l:Loc Common_Refresh}"
                                    controls:ChartHoverInfoBehavior.Description="{l:Loc Dash_Explain_RefreshNetwork_Desc}"
                                    controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Dash_Explain_RefreshNetwork_Metrics}"
                                    controls:ChartHoverInfoBehavior.DelaySeconds="1.5">
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE72C;" FontSize="14" IsHitTestVisible="False" />
                            </Button>
                        </Grid>

                        <TextBlock Style="{StaticResource Text.Body}" Text="{l:Loc Dash_Network_NoActive}"
                                   Foreground="{DynamicResource Brush.TextSecondary}">
                            <TextBlock.Visibility>
                                <MultiBinding Converter="{StaticResource NoAdapterVisibility}">
                                    <Binding Path="HasSnapshot" />
                                    <Binding Path="PrimaryAdapter" />
                                </MultiBinding>
                            </TextBlock.Visibility>
                        </TextBlock>

                        <Grid Visibility="{Binding PrimaryAdapter, Converter={StaticResource NullToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Style="{StaticResource Cell}" Margin="0,0,12,12" Background="Transparent"
                                        controls:ChartHoverInfoBehavior.Title="{l:Loc Dash_Network_Adapter}"
                                        controls:ChartHoverInfoBehavior.Description="{l:Loc Dash_Explain_NetAdapter_Desc}"
                                        controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Dash_Explain_NetAdapter_Metrics}"
                                        controls:ChartHoverInfoBehavior.DelaySeconds="1.5">
                                <TextBlock Style="{StaticResource KeyText}" Text="{l:Loc Dash_Network_Adapter}" IsHitTestVisible="False" />
                                <TextBlock Style="{StaticResource Text.Body}" Text="{Binding PrimaryAdapter.Name}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" IsHitTestVisible="False" />
                                <TextBlock Style="{StaticResource Text.Caption}" FontSize="{DynamicResource Font.Size.Small}"
                                           Text="{Binding PrimaryAdapter.Description}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" IsHitTestVisible="False" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Cell}" Grid.Column="1" Margin="0,0,0,12" Background="Transparent"
                                        controls:ChartHoverInfoBehavior.Title="{l:Loc Dash_Network_Type}"
                                        controls:ChartHoverInfoBehavior.Description="{l:Loc Dash_Explain_NetType_Desc}"
                                        controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Dash_Explain_NetType_Metrics}"
                                        controls:ChartHoverInfoBehavior.DelaySeconds="1.5">
                                <TextBlock Style="{StaticResource KeyText}" Text="{l:Loc Dash_Network_Type}" IsHitTestVisible="False" />
                                <TextBlock Style="{StaticResource Text.Body}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" IsHitTestVisible="False">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LocKey}" ConverterParameter="AdapterKind_">
                                            <Binding Path="PrimaryAdapter.Kind" />
                                            <Binding Path="Culture" Source="{x:Static l:LocalizationManager.Instance}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Text.Caption}" FontSize="{DynamicResource Font.Size.Small}"
                                           Text="{Binding PrimaryAdapter.SpeedBitsPerSecond, Converter={StaticResource LinkSpeed}}" IsHitTestVisible="False" />
                            </StackPanel>

                            <StackPanel Style="{StaticResource Cell}" Grid.Row="1" Margin="0,0,12,12" Background="Transparent"
                                        controls:ChartHoverInfoBehavior.Title="{l:Loc Dash_Network_LocalIp}"
                                        controls:ChartHoverInfoBehavior.Description="{l:Loc Dash_Explain_NetIp_Desc}"
                                        controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Dash_Explain_NetIp_Metrics}"
                                        controls:ChartHoverInfoBehavior.DelaySeconds="1.5">
                                <TextBlock Style="{StaticResource KeyText}" Text="{l:Loc Dash_Network_LocalIp}" IsHitTestVisible="False" />
                                <TextBlock Style="{StaticResource Text.Mono}" FontSize="{DynamicResource Font.Size.Caption}"
                                           Text="{Binding PrimaryAdapter.IPv4Addresses, Converter={StaticResource AddressList}}"
                                           TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Cell}" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" Background="Transparent"
                                        controls:ChartHoverInfoBehavior.Title="{l:Loc Dash_Network_Gateway}"
                                        controls:ChartHoverInfoBehavior.Description="{l:Loc Dash_Explain_NetGateway_Desc}"
                                        controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Dash_Explain_NetGateway_Metrics}"
                                        controls:ChartHoverInfoBehavior.DelaySeconds="1.5">
                                <TextBlock Style="{StaticResource KeyText}" Text="{l:Loc Dash_Network_Gateway}" IsHitTestVisible="False" />
                                <TextBlock Style="{StaticResource Text.Mono}" FontSize="{DynamicResource Font.Size.Caption}"
                                           Text="{Binding PrimaryAdapter.Gateways, Converter={StaticResource AddressList}}"
                                           TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                            </StackPanel>

                            <StackPanel Style="{StaticResource Cell}" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,12" Background="Transparent"
                                        controls:ChartHoverInfoBehavior.Title="{l:Loc Dash_Network_Dns}"
                                        controls:ChartHoverInfoBehavior.Description="{l:Loc Dash_Explain_NetDns_Desc}"
                                        controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Dash_Explain_NetDns_Metrics}"
                                        controls:ChartHoverInfoBehavior.DelaySeconds="1.5">
                                <TextBlock Style="{StaticResource KeyText}" Text="{l:Loc Dash_Network_Dns}" IsHitTestVisible="False" />
                                <TextBlock Style="{StaticResource Text.Mono}" FontSize="{DynamicResource Font.Size.Caption}"
                                           Text="{Binding PrimaryAdapter.DnsServers, Converter={StaticResource AddressList}}"
                                           TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                            </StackPanel>

                            <StackPanel Style="{StaticResource Cell}" Grid.Row="3" Margin="0,0,12,0" Background="Transparent"
                                        controls:ChartHoverInfoBehavior.Title="{l:Loc Dash_Network_IPv4}"
                                        controls:ChartHoverInfoBehavior.Description="{l:Loc Dash_Explain_NetIpv4_Desc}"
                                        controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Dash_Explain_NetIpv4_Metrics}"
                                        controls:ChartHoverInfoBehavior.DelaySeconds="1.5">
                                <TextBlock Style="{StaticResource KeyText}" Text="{l:Loc Dash_Network_IPv4}" IsHitTestVisible="False" />
                                <TextBlock Style="{StaticResource Text.Body}" IsHitTestVisible="False">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LocKey}" ConverterParameter="IpStatus_">
                                            <Binding Path="Ipv4Status" />
                                            <Binding Path="Culture" Source="{x:Static l:LocalizationManager.Instance}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Style="{StaticResource Cell}" Grid.Row="3" Grid.Column="1" Margin="0" Background="Transparent"
                                        controls:ChartHoverInfoBehavior.Title="{l:Loc Dash_Network_IPv6}"
                                        controls:ChartHoverInfoBehavior.Description="{l:Loc Dash_Explain_NetIpv6_Desc}"
                                        controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Dash_Explain_NetIpv6_Metrics}"
                                        controls:ChartHoverInfoBehavior.DelaySeconds="1.5">
                                <TextBlock Style="{StaticResource KeyText}" Text="{l:Loc Dash_Network_IPv6}" IsHitTestVisible="False" />
                                <TextBlock Style="{StaticResource Text.Body}" IsHitTestVisible="False">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LocKey}" ConverterParameter="IpStatus_">
                                            <Binding Path="Ipv6Status" />
                                            <Binding Path="Culture" Source="{x:Static l:LocalizationManager.Instance}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Right: Live Running DNS Query Log Card -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20,16" Margin="7,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent"
                                        controls:ChartHoverInfoBehavior.Title="{l:Loc Dash_LiveLog_Title}"
                                        controls:ChartHoverInfoBehavior.Description="{l:Loc Dash_Explain_LiveLog_Desc}"
                                        controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Dash_Explain_LiveLog_Metrics}"
                                        controls:ChartHoverInfoBehavior.DelaySeconds="1.5">
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE9D5;" FontSize="15"
                                           Foreground="{DynamicResource Brush.Accent}" Margin="0,0,8,0" IsHitTestVisible="False" />
                                <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{l:Loc Dash_LiveLog_Title}"
                                           VerticalAlignment="Center" IsHitTestVisible="False" />
                                <Border Margin="10,0,0,0" IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                            <Setter Property="Padding" Value="8,2" />
                                            <Setter Property="Background" Value="{DynamicResource Brush.SuccessSubtle}" />
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Success}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsQueryLogPaused}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.WarningSubtle}" />
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Warning}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center"
                                                 Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}" />
                                        <TextBlock FontSize="10" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{l:Loc Dash_LiveLog_Live}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsQueryLogPaused}" Value="True">
                                                            <Setter Property="Text" Value="{l:Loc Dash_LiveLog_Paused}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding ToggleQueryLogPauseCommand}" Padding="9,4" Margin="0,0,6,0"
                                        FontSize="{DynamicResource Font.Size.Small}">
                                    <TextBlock IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{l:Loc Dash_LiveLog_Pause}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsQueryLogPaused}" Value="True">
                                                        <Setter Property="Text" Value="{l:Loc Dash_LiveLog_Resume}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <Button Command="{Binding ClearRecentQueriesCommand}" Content="{l:Loc Dash_LiveLog_Clear}"
                                        Padding="9,4" Margin="0,0,6,0" FontSize="{DynamicResource Font.Size.Small}" />
                                <Button Command="{Binding OpenMonitorCommand}" Content="{l:Loc Dash_LiveLog_OpenMonitor}"
                                        Padding="9,4" FontSize="{DynamicResource Font.Size.Small}" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" Height="232" Background="{DynamicResource Brush.ControlFill}"
                                BorderBrush="{DynamicResource Brush.ControlBorder}" BorderThickness="1" CornerRadius="6" Padding="6">
                            <Grid>
                                <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc Dash_LiveLog_Empty}"
                                           Foreground="{DynamicResource Brush.TextTertiary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                           Margin="16"
                                           Visibility="{Binding HasRecentQueries, Converter={StaticResource InverseBoolToVisibility}}" />

                                <ListBox ItemsSource="{Binding RecentQueries}"
                                         Background="Transparent" BorderThickness="0"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         Visibility="{Binding HasRecentQueries, Converter={StaticResource BoolToVisibility}}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="6,3" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="RowBorder" Background="{TemplateBinding Background}"
                                                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource Brush.SubtleHover}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:LiveQueryMonitorEntry}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58" />
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="106" />
                                                    <ColumnDefinition Width="56" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Style="{StaticResource Text.Mono}" FontSize="{DynamicResource Font.Size.Small}"
                                                           Foreground="{DynamicResource Brush.TextTertiary}" VerticalAlignment="Center"
                                                           Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" />

                                                <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                                            <Setter Property="Padding" Value="7,2" />
                                                            <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Accent}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Outcome}" Value="Cached">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.SuccessSubtle}" />
                                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Success}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Outcome}" Value="Blocked">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.DangerSubtle}" />
                                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Danger}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Outcome}" Value="Failed">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.WarningSubtle}" />
                                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Warning}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="10.5" FontWeight="SemiBold"
                                                               Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"
                                                               Text="{Binding Outcome}" />
                                                </Border>

                                                <TextBlock Grid.Column="2" Style="{StaticResource Text.Mono}" FontSize="{DynamicResource Font.Size.Small}"
                                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                                           Text="{Binding RecordType}" VerticalAlignment="Center" />

                                                <TextBlock Grid.Column="3" Style="{StaticResource Text.Mono}" FontSize="{DynamicResource Font.Size.Small}"
                                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                                           Text="{Binding Domain}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                           Margin="0,0,8,0" VerticalAlignment="Center" />

                                                <TextBlock Grid.Column="4" Style="{StaticResource Text.Caption}" FontSize="{DynamicResource Font.Size.Small}"
                                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                                           Text="{Binding ResolverName}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                           Margin="0,0,6,0" VerticalAlignment="Center" />

                                                <TextBlock Grid.Column="5" Style="{StaticResource Text.Mono}" FontSize="{DynamicResource Font.Size.Small}"
                                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                                           Text="{Binding LatencyMs, StringFormat={}{0:0.#} ms, TargetNullValue=—}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
