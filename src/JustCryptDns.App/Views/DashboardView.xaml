<UserControl x:Class="JustCryptDns.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:JustCryptDns.App.ViewModels"
             xmlns:l="clr-namespace:JustCryptDns.App.Localization"
             xmlns:ipc="clr-namespace:JustCryptDns.Core.Ipc;assembly=JustCryptDns.Core"
             xmlns:models="clr-namespace:JustCryptDns.Core.Models;assembly=JustCryptDns.Core"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}">
    <UserControl.Resources>
        <Style x:Key="KeyText" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="FontSize" Value="{DynamicResource Font.Size.BodyLarge}" />
        </Style>
        <Style x:Key="Cell" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,24,18" />
        </Style>
        <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="{DynamicResource Card.GapGrid}" />
            <Setter Property="Padding" Value="{DynamicResource Card.PaddingSmall}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="32,4,32,32">
            <TextBlock Style="{StaticResource Text.PageTitle}" Text="{l:Loc Nav_Dashboard}" />
            <TextBlock Style="{StaticResource Text.Subtitle}" Text="{l:Loc Page_Dashboard_Subtitle}" Margin="0,4,0,22" />

            <!-- System Traffic Warning Banner (Non-53 port or Adapter DNS not pointing to local proxy) -->
            <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.WarningSubtle}" BorderBrush="{DynamicResource Brush.Warning}"
                    Padding="18,14" Margin="{DynamicResource Card.Gap}"
                    Visibility="{Binding TrafficWarningBanner, Converter={StaticResource NullToVisibility}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7BA;" FontSize="18" Foreground="{DynamicResource Brush.Warning}" Margin="0,0,14,0" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}" Text="{Binding TrafficWarningBanner}" VerticalAlignment="Center" />
                    </Grid>
                    <WrapPanel Orientation="Horizontal" Margin="32,12,0,0">
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding UseAlternateLoopbackPort53Command}" Margin="0,0,8,4"
                                Visibility="{Binding SuggestedLoopbackIp, Converter={StaticResource NullToVisibility}}">
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource LocFormat}" ConverterParameter="TrafficFix_UseLoopback53">
                                        <Binding Path="SuggestedLoopbackIp" />
                                        <Binding Path="Culture" Source="{x:Static l:LocalizationManager.Instance}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Button>
                        <Button Command="{Binding StopConflictingServiceAndUsePort53Command}" Margin="0,0,8,4"
                                Visibility="{Binding ConflictingServiceName, Converter={StaticResource NullToVisibility}}">
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource LocFormat}" ConverterParameter="TrafficFix_StopService53">
                                        <Binding Path="ConflictingServiceName" />
                                        <Binding Path="Culture" Source="{x:Static l:LocalizationManager.Instance}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Button>
                        <Button Command="{Binding TestLocalProxyCommand}" Content="{l:Loc DnsMgr_TestLocalProxy}" Margin="0,0,8,4" />
                        <Button Command="{Binding OpenDnsManagerCommand}" Content="{l:Loc Nav_DnsManager}" Margin="0,0,0,4" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Error Banner -->
            <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.DangerSubtle}" BorderBrush="{DynamicResource Brush.Danger}"
                    Padding="16,12" Margin="{DynamicResource Card.Gap}"
                    Visibility="{Binding EngineError, Converter={StaticResource NullToVisibility}}">
                <TextBlock Style="{StaticResource Text.Body}" Text="{Binding EngineError}" />
            </Border>

            <!-- Local Proxy Test Feedback Banner -->
            <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.SuccessSubtle}" BorderBrush="{DynamicResource Brush.Success}"
                    Padding="16,12" Margin="{DynamicResource Card.Gap}"
                    Visibility="{Binding TestProxyFeedback, Converter={StaticResource NullToVisibility}}">
                <TextBlock Style="{StaticResource Text.Body}" Text="{Binding TestProxyFeedback}" />
            </Border>

            <!-- Protection status -->
            <Border Style="{StaticResource Card}" Margin="{DynamicResource Card.Gap}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Width="56" Height="56" CornerRadius="28" VerticalAlignment="Top">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Brush.NeutralSubtle}" />
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Neutral}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EngineState}" Value="{x:Static ipc:DnsEngineState.Running}">
                                        <Setter Property="Background" Value="{DynamicResource Brush.SuccessSubtle}" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Success}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EngineState}" Value="{x:Static ipc:DnsEngineState.Degraded}">
                                        <Setter Property="Background" Value="{DynamicResource Brush.WarningSubtle}" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Warning}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xEA18;" FontSize="24"
                                   Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="18,0,24,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc Dash_Protection_Title}" />
                        <TextBlock FontSize="{DynamicResource Font.Size.Hero}" FontWeight="SemiBold" Margin="0,2,0,4"
                                   FontFamily="{StaticResource Font.Display}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource LocKey}" ConverterParameter="EngineState_">
                                    <Binding Path="EngineState" />
                                    <Binding Path="Culture" Source="{x:Static l:LocalizationManager.Instance}" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock MaxWidth="560" HorizontalAlignment="Left">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                    <Setter Property="Text" Value="{l:Loc Dash_Protection_StoppedDetail}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEngineRunning}" Value="True">
                                            <Setter Property="Text" Value="{l:Loc Dash_Protection_RunningDetail}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <Button Grid.Column="2" Style="{StaticResource Button.Primary}" VerticalAlignment="Center" Padding="20,10"
                            Command="{Binding ToggleEngineCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE768;" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{l:Loc Dash_StartEngine}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEngineRunning}" Value="True">
                                                <Setter Property="Text" Value="{l:Loc DnsMgr_StopEngine}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <UniformGrid Grid.Row="1" Grid.ColumnSpan="3" Rows="1" Margin="0,22,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource KeyText}" Text="{l:Loc Dash_Protocol}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding ActiveProtocol}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource KeyText}" Text="{l:Loc Dash_Resolver}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding ActiveResolverName}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource KeyText}" Text="{l:Loc DnsMgr_LocalProxy}" />
                            <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding ListenEndpoint}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource KeyText}" Text="{l:Loc Dash_Filtering}" />
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ValueText}">
                                        <Setter Property="Text" Value="{l:Loc Animations_Off}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFilteringActive}" Value="True">
                                                <Setter Property="Text" Value="{l:Loc Filtering_Stat_Active}" />
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- Engine metrics -->
            <UniformGrid x:Name="Metrics" Margin="{DynamicResource Card.GridCompensation}"
                         Columns="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource WidthToColumns}}">
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc Dash_Metric_Latency}" />
                        <TextBlock Style="{StaticResource Text.Metric}" Text="{Binding LatencyDisplay}" Margin="0,6,0,2" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding ActiveResolverName}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc Dash_Metric_Queries}" />
                        <TextBlock Style="{StaticResource Text.Metric}" Text="{Binding TotalQueriesDisplay}" Margin="0,6,0,2" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding ListenEndpoint}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc Dash_Metric_Blocked}" />
                        <TextBlock Style="{StaticResource Text.Metric}" Text="{Binding BlockedQueriesDisplay}" Margin="0,6,0,2" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc Nav_Filtering}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc Dash_Metric_CacheHit}" />
                        <TextBlock Style="{StaticResource Text.Metric}" Text="{Binding CacheHitDisplay}" Margin="0,6,0,2" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="TTL Cache" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- DPI Bypass & Firewall Protection Card -->
            <Border Style="{StaticResource Card}" Margin="{DynamicResource Card.Gap}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Width="42" Height="42" CornerRadius="21" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Brush.NeutralSubtle}" />
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Neutral}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BypassState}" Value="{x:Static models:BypassEngineState.Running}">
                                        <Setter Property="Background" Value="{DynamicResource Brush.SuccessSubtle}" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Success}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BypassState}" Value="{x:Static models:BypassEngineState.Degraded}">
                                        <Setter Property="Background" Value="{DynamicResource Brush.WarningSubtle}" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Warning}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE705;" FontSize="18"
                                   Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc Dash_Bypass_Title}" />
                        <TextBlock Style="{StaticResource Text.SectionTitle}" Margin="0,2,0,2">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource LocKey}" ConverterParameter="BypassState_">
                                    <Binding Path="BypassState" />
                                    <Binding Path="Culture" Source="{x:Static l:LocalizationManager.Instance}" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc Dash_Bypass_Desc}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding OpenBypassCommand}" Content="{l:Loc Dash_Bypass_Configure}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding ToggleBypassCommand}">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{l:Loc Bypass_StartEngine}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBypassRunning}" Value="True">
                                                <Setter Property="Text" Value="{l:Loc Bypass_StopEngine}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </StackPanel>

                    <UniformGrid Grid.Row="1" Grid.ColumnSpan="3" Rows="1" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource KeyText}" Text="{l:Loc Bypass_ProxyEndpoint}" />
                            <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding BypassEndpoint}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource KeyText}" Text="{l:Loc Bypass_CoverageMode}" />
                            <TextBlock Style="{StaticResource ValueText}">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource LocKey}" ConverterParameter="CoverageMode_">
                                        <Binding Path="BypassCoverageMode" />
                                        <Binding Path="Culture" Source="{x:Static l:LocalizationManager.Instance}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource KeyText}" Text="{l:Loc Bypass_Metric_DpiBypassed}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding BypassDpiCountDisplay}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource KeyText}" Text="{l:Loc Dash_Bypass_Tunneled}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding BypassTunnelCountDisplay}" />
                        </StackPanel>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- Network: real local adapter data. -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{l:Loc Dash_Network_Title}" VerticalAlignment="Center" />

                        <Border Grid.Column="1" Margin="12,0,0,0" Visibility="{Binding HasSnapshot, Converter={StaticResource BoolToVisibility}}">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                    <Setter Property="Background" Value="{DynamicResource Brush.DangerSubtle}" />
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Danger}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Connectivity}" Value="{x:Static models:LocalConnectivity.LocalOnly}">
                                            <Setter Property="Background" Value="{DynamicResource Brush.WarningSubtle}" />
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Warning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Connectivity}" Value="{x:Static models:LocalConnectivity.GatewayAvailable}">
                                            <Setter Property="Background" Value="{DynamicResource Brush.SuccessSubtle}" />
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Success}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"
                                         Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}" />
                                <TextBlock FontSize="{DynamicResource Font.Size.Caption}" FontWeight="SemiBold">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LocKey}" ConverterParameter="Connectivity_">
                                            <Binding Path="Connectivity" />
                                            <Binding Path="Culture" Source="{x:Static l:LocalizationManager.Instance}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource LocFormat}" ConverterParameter="Dash_Network_Updated">
                                        <Binding Path="LastUpdated" />
                                        <Binding Path="Culture" Source="{x:Static l:LocalizationManager.Instance}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <Button Style="{StaticResource Button.Subtle}" Command="{Binding RefreshCommand}" Padding="10,6"
                                    ToolTip="{l:Loc Common_Refresh}" AutomationProperties.Name="{l:Loc Common_Refresh}">
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE72C;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextTertiary}"
                               Text="{l:Loc Dash_Network_LocalNote}" Margin="0,0,0,20" />

                    <TextBlock Style="{StaticResource Text.Body}" Text="{l:Loc Dash_Network_NoActive}"
                               Foreground="{DynamicResource Brush.TextSecondary}">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{StaticResource NoAdapterVisibility}">
                                <Binding Path="HasSnapshot" />
                                <Binding Path="PrimaryAdapter" />
                            </MultiBinding>
                        </TextBlock.Visibility>
                    </TextBlock>

                    <Grid Visibility="{Binding PrimaryAdapter, Converter={StaticResource NullToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Style="{StaticResource Cell}" Grid.ColumnSpan="2">
                            <TextBlock Style="{StaticResource KeyText}" Text="{l:Loc Dash_Network_Adapter}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding PrimaryAdapter.Name}" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding PrimaryAdapter.Description}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}" Grid.Column="2">
                            <TextBlock Style="{StaticResource KeyText}" Text="{l:Loc Dash_Network_Type}" />
                            <TextBlock Style="{StaticResource ValueText}">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource LocKey}" ConverterParameter="AdapterKind_">
                                        <Binding Path="PrimaryAdapter.Kind" />
                                        <Binding Path="Culture" Source="{x:Static l:LocalizationManager.Instance}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding PrimaryAdapter.SpeedBitsPerSecond, Converter={StaticResource LinkSpeed}}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource Cell}" Grid.Row="1">
                            <TextBlock Style="{StaticResource KeyText}" Text="{l:Loc Dash_Network_LocalIp}" />
                            <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding PrimaryAdapter.IPv4Addresses, Converter={StaticResource AddressList}}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}" Grid.Row="1" Grid.Column="1">
                            <TextBlock Style="{StaticResource KeyText}" Text="{l:Loc Dash_Network_Gateway}" />
                            <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding PrimaryAdapter.Gateways, Converter={StaticResource AddressList}}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}" Grid.Row="1" Grid.Column="2">
                            <TextBlock Style="{StaticResource KeyText}" Text="{l:Loc Dash_Network_Dns}" />
                            <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding PrimaryAdapter.DnsServers, Converter={StaticResource AddressList}}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource Cell}" Grid.Row="2">
                            <TextBlock Style="{StaticResource KeyText}" Text="{l:Loc Dash_Network_IPv4}" />
                            <TextBlock Style="{StaticResource ValueText}">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource LocKey}" ConverterParameter="IpStatus_">
                                        <Binding Path="Ipv4Status" />
                                        <Binding Path="Culture" Source="{x:Static l:LocalizationManager.Instance}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}" Grid.Row="2" Grid.Column="1">
                            <TextBlock Style="{StaticResource KeyText}" Text="{l:Loc Dash_Network_IPv6}" />
                            <TextBlock Style="{StaticResource ValueText}">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource LocKey}" ConverterParameter="IpStatus_">
                                        <Binding Path="Ipv6Status" />
                                        <Binding Path="Culture" Source="{x:Static l:LocalizationManager.Instance}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
