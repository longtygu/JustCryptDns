<UserControl x:Class="JustCryptDns.App.Views.DnsManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:JustCryptDns.App.ViewModels"
             xmlns:ipc="clr-namespace:JustCryptDns.Core.Ipc;assembly=JustCryptDns.Core"
             xmlns:l="clr-namespace:JustCryptDns.App.Localization"
             xmlns:controls="clr-namespace:JustCryptDns.App.Controls"
             mc:Ignorable="d" d:DesignWidth="950" d:DesignHeight="1050"
             d:DataContext="{d:DesignInstance Type=vm:DnsManagerViewModel}">
    <UserControl.Resources>
        <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="{DynamicResource Card.Gap}" />
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="FontSize" Value="{DynamicResource Font.Size.BodyLarge}" />
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Divider}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Margin" Value="0,16,0,16" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="32,4,32,32" MaxWidth="920">
            <TextBlock Style="{StaticResource Text.PageTitle}" Text="{l:Loc Nav_DnsManager}" />
            <TextBlock Style="{StaticResource Text.Subtitle}" Text="{l:Loc Page_DnsManager_Subtitle}" Margin="0,4,0,22" />

            <!-- Port conflict banner -->
            <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.WarningSubtle}" BorderBrush="{DynamicResource Brush.Warning}"
                    Padding="18,14" Margin="{DynamicResource Card.Gap}" Visibility="Collapsed"
                    controls:DismissBannerBehavior.BannerContent="{Binding PortConflict}"
                    controls:DismissBannerBehavior.PersistKey="PortConflict">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7BA;" FontSize="18" Foreground="{DynamicResource Brush.Warning}" Margin="0,0,14,0" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource RowTitle}" FontWeight="SemiBold" Text="{l:Loc DnsMgr_PortConflictTitle}" />
                            <TextBox Style="{StaticResource TextBox.SelectableReadOnly}" FontSize="{DynamicResource Font.Size.Caption}"
                                     Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding PortConflict.Message, Mode=OneWay}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource Button.CopyInline}"
                                    controls:CopyTextBehavior.CopyText="{Binding PortConflict.Message}" />
                            <Button Style="{StaticResource Button.DismissInline}" Margin="4,0,0,0"
                                    controls:DismissBannerBehavior.IsDismissButton="True" />
                        </StackPanel>
                    </Grid>
                    <WrapPanel Orientation="Horizontal" Margin="32,12,0,0">
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding UseAlternateLoopbackPort53Command}" Margin="0,0,8,4"
                                Visibility="{Binding SuggestedLoopbackIp, Converter={StaticResource NullToVisibility}}">
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource LocFormat}" ConverterParameter="TrafficFix_UseLoopback53">
                                        <Binding Path="SuggestedLoopbackIp" />
                                        <Binding Path="Culture" Source="{x:Static l:LocalizationManager.Instance}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Button>
                        <Button Command="{Binding StopConflictingServiceAndUsePort53Command}" Margin="0,0,8,4"
                                Visibility="{Binding ConflictingServiceName, Converter={StaticResource NullToVisibility}}">
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource LocFormat}" ConverterParameter="TrafficFix_StopService53">
                                        <Binding Path="ConflictingServiceName" />
                                        <Binding Path="Culture" Source="{x:Static l:LocalizationManager.Instance}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Button>
                        <Button Command="{Binding UseSuggestedPortCommand}" Margin="0,0,0,4">
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource LocFormat}" ConverterParameter="DnsMgr_UseSuggestedPort">
                                        <Binding Path="PortConflict.SuggestedPort" />
                                        <Binding Path="Culture" Source="{x:Static l:LocalizationManager.Instance}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- System Traffic Warning Banner (Non-53 port or Adapter DNS not configured) -->
            <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.WarningSubtle}" BorderBrush="{DynamicResource Brush.Warning}"
                    Padding="18,14" Margin="{DynamicResource Card.Gap}" Visibility="Collapsed"
                    controls:DismissBannerBehavior.BannerContent="{Binding TrafficWarningBanner}"
                    controls:DismissBannerBehavior.PersistKey="TrafficWarning">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7BA;" FontSize="18" Foreground="{DynamicResource Brush.Warning}" Margin="0,0,14,0" VerticalAlignment="Top" />
                        <TextBox Grid.Column="1" Style="{StaticResource TextBox.SelectableReadOnly}" Text="{Binding TrafficWarningBanner, Mode=OneWay}"
                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource Button.CopyInline}"
                                    controls:CopyTextBehavior.CopyText="{Binding TrafficWarningBanner}" />
                            <Button Style="{StaticResource Button.DismissInline}" Margin="4,0,0,0"
                                    controls:DismissBannerBehavior.IsDismissButton="True" />
                        </StackPanel>
                    </Grid>
                    <WrapPanel Orientation="Horizontal" Margin="32,12,0,0">
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding UseAlternateLoopbackPort53Command}" Margin="0,0,8,4"
                                Visibility="{Binding SuggestedLoopbackIp, Converter={StaticResource NullToVisibility}}">
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource LocFormat}" ConverterParameter="TrafficFix_UseLoopback53">
                                        <Binding Path="SuggestedLoopbackIp" />
                                        <Binding Path="Culture" Source="{x:Static l:LocalizationManager.Instance}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Button>
                        <Button Command="{Binding StopConflictingServiceAndUsePort53Command}" Margin="0,0,8,4"
                                Visibility="{Binding ConflictingServiceName, Converter={StaticResource NullToVisibility}}">
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource LocFormat}" ConverterParameter="TrafficFix_StopService53">
                                        <Binding Path="ConflictingServiceName" />
                                        <Binding Path="Culture" Source="{x:Static l:LocalizationManager.Instance}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Button>
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding ApplyWindowsAdapterDnsNowCommand}"
                                Content="{l:Loc TrafficFix_ApplyAdapterDnsNow}" Margin="0,0,8,4"
                                Visibility="{Binding CanFixAdapterDns, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding PauseForCaptivePortalCommand}"
                                Content="{l:Loc Dns_PauseCaptivePortal}" Margin="0,0,8,4"
                                Visibility="{Binding CanPauseCaptivePortal, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding ResumeFromCaptivePortalCommand}"
                                Content="{l:Loc Dns_ResumeCaptivePortal}" Margin="0,0,8,4"
                                Visibility="{Binding IsCaptivePortalPaused, Converter={StaticResource BoolToVisibility}}" />
                        <Button Command="{Binding TestLocalProxyCommand}" Content="{l:Loc DnsMgr_TestLocalProxy}" Margin="0,0,8,4" />
                        <Button Command="{Binding SwitchToPort53Command}" Content="{l:Loc DnsMgr_SwitchToPort53}" Margin="0,0,0,4"
                                Visibility="{Binding IsNonStandardPort, Converter={StaticResource BoolToVisibility}}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Unencrypted DNS Warning Banner -->
            <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.WarningSubtle}" BorderBrush="{DynamicResource Brush.Warning}"
                    Padding="18,14" Margin="{DynamicResource Card.Gap}" Visibility="Collapsed"
                    controls:DismissBannerBehavior.BannerContent="{Binding IsUnencryptedDnsActive}"
                    controls:DismissBannerBehavior.PersistKey="UnencryptedDns">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7BA;" FontSize="18" Foreground="{DynamicResource Brush.Warning}" Margin="0,0,14,0" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Text="{l:Loc DnsWarn_UnencryptedActive}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Grid.Column="2" Style="{StaticResource Button.DismissInline}"
                                controls:DismissBannerBehavior.IsDismissButton="True" />
                    </Grid>
                    <WrapPanel Orientation="Horizontal" Margin="32,12,0,0">
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding SwitchToEncryptedDnsCommand}"
                                Content="{l:Loc DnsWarn_SwitchToEncryptedDoh}" Margin="0,0,8,4" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Error / Info alerts (Selectable, Copyable & Dismissible) -->
            <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.DangerSubtle}" BorderBrush="{DynamicResource Brush.Danger}"
                    Padding="16,12" Margin="{DynamicResource Card.Gap}" Visibility="Collapsed"
                    controls:DismissBannerBehavior.BannerContent="{Binding ErrorMessage}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource TextBox.SelectableReadOnly}" Text="{Binding ErrorMessage, Mode=OneWay}"
                             Margin="0,0,8,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource Button.CopyInline}"
                                controls:CopyTextBehavior.CopyText="{Binding ErrorMessage}" />
                        <Button Style="{StaticResource Button.DismissInline}" Margin="4,0,0,0"
                                controls:DismissBannerBehavior.IsDismissButton="True" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.SuccessSubtle}" BorderBrush="{DynamicResource Brush.Success}"
                    Padding="16,12" Margin="{DynamicResource Card.Gap}" Visibility="Collapsed"
                    controls:DismissBannerBehavior.BannerContent="{Binding InfoMessage}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource TextBox.SelectableReadOnly}" Text="{Binding InfoMessage, Mode=OneWay}"
                             Margin="0,0,8,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource Button.CopyInline}"
                                controls:CopyTextBehavior.CopyText="{Binding InfoMessage}" />
                        <Button Style="{StaticResource Button.DismissInline}" Margin="4,0,0,0"
                                controls:DismissBannerBehavior.IsDismissButton="True" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Engine Control Card -->
            <Border Style="{StaticResource SectionCard}"
                    controls:ChartHoverInfoBehavior.Title="{l:Loc Info_DnsMgr_Engine_Title}"
                    controls:ChartHoverInfoBehavior.Description="{l:Loc Info_DnsMgr_Engine_Desc}"
                    controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Info_DnsMgr_Engine_Meaning}"
                    controls:ChartHoverInfoBehavior.DelaySeconds="1.5">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="26" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Brush.DangerSubtle}" />
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Danger}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EngineState}" Value="{x:Static ipc:DnsEngineState.Running}">
                                            <Setter Property="Background" Value="{DynamicResource Brush.SuccessSubtle}" />
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Success}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EngineState}" Value="{x:Static ipc:DnsEngineState.Degraded}">
                                            <Setter Property="Background" Value="{DynamicResource Brush.WarningSubtle}" />
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Warning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EngineState}" Value="{x:Static ipc:DnsEngineState.Starting}">
                                            <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Accent}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EngineState}" Value="{x:Static ipc:DnsEngineState.Stopping}">
                                            <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xEA18;" FontSize="22"
                                       Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="18,0,20,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{l:Loc DnsMgr_EngineTitle}" VerticalAlignment="Center" />
                                <Border Margin="10,0,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                            <Setter Property="Background" Value="{DynamicResource Brush.DangerSubtle}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Danger}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EngineState}" Value="{x:Static ipc:DnsEngineState.Running}">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.SuccessSubtle}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Success}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding EngineState}" Value="{x:Static ipc:DnsEngineState.Degraded}">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.WarningSubtle}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}" />
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Warning}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding EngineState}" Value="{x:Static ipc:DnsEngineState.Starting}">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Accent}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding EngineState}" Value="{x:Static ipc:DnsEngineState.Stopping}">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Accent}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="{DynamicResource Font.Size.Caption}" FontWeight="SemiBold"
                                               Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource LocKey}" ConverterParameter="EngineState_">
                                                <Binding Path="EngineState" />
                                                <Binding Path="Culture" Source="{x:Static l:LocalizationManager.Instance}" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" Text="{Binding SelectedResolver.Name}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding ProbeResolverCommand}" Margin="0,0,8,0" Content="{l:Loc DnsMgr_TestResolver}" />
                            <Button Command="{Binding RestartEngineCommand}" Margin="0,0,8,0" Content="{l:Loc DnsMgr_Restart}"
                                    IsEnabled="{Binding IsEngineRunning}" />
                            <Button Style="{StaticResource Button.Primary}" Command="{Binding ToggleEngineCommand}" Padding="18,8">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{l:Loc Dash_StartEngine}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEngineRunning}" Value="True">
                                                    <Setter Property="Text" Value="{l:Loc DnsMgr_StopEngine}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Divider}" />
                    <UniformGrid Rows="1" Columns="4">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc DnsMgr_LocalProxy}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBox Style="{StaticResource TextBox.SelectableReadOnlyMono}" Text="{Binding ListenEndpoint, Mode=OneWay}" VerticalAlignment="Center" />
                                <Button Style="{StaticResource Button.CopyInline}" Width="22" Height="22" Margin="4,0,0,0"
                                        controls:CopyTextBehavior.CopyText="{Binding ListenEndpoint}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc Dash_Metric_Latency}" />
                            <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="{Binding LastLatencyText}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc Dash_Metric_Queries}" />
                            <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="{Binding TotalQueries}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Label}" Text="{l:Loc DnsMgr_SuccessFailed}" />
                            <TextBlock Style="{StaticResource Text.Body}" Margin="0,4,0,0">
                                <Run Text="{Binding SuccessfulQueries, Mode=OneWay}" />
                                <Run Text="/" />
                                <Run Text="{Binding FailedQueries, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Active Resolver Selection & Failover Policy -->
            <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{l:Loc DnsMgr_ResolverSection}" Margin="0,12,0,10" />
            <Border Style="{StaticResource SectionCard}"
                    controls:ChartHoverInfoBehavior.Title="{l:Loc Info_DnsMgr_Resolver_Title}"
                    controls:ChartHoverInfoBehavior.Description="{l:Loc Info_DnsMgr_Resolver_Desc}"
                    controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Info_DnsMgr_Resolver_Meaning}"
                    controls:ChartHoverInfoBehavior.DelaySeconds="1.5">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{l:Loc DnsMgr_ActiveResolver}" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBox Style="{StaticResource TextBox.SelectableReadOnlyMono}" FontSize="{DynamicResource Font.Size.Caption}"
                                         Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding SelectedResolver.Endpoint, Mode=OneWay}" VerticalAlignment="Center" />
                                <Button Style="{StaticResource Button.CopyInline}" Width="22" Height="22" Margin="4,0,0,0"
                                        controls:CopyTextBehavior.CopyText="{Binding SelectedResolver.Endpoint}" />
                            </StackPanel>
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Resolvers}" SelectedItem="{Binding SelectedResolver}"
                                  DisplayMemberPath="Name" AutomationProperties.Name="{l:Loc DnsMgr_ActiveResolver}" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{l:Loc Resilience_FailoverTitle}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc Resilience_FailoverDesc}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding FailoverPolicies}" SelectedItem="{Binding SelectedFailoverPolicy}"
                                  Margin="0,0,12,0" AutomationProperties.Name="{l:Loc Resilience_FailoverTitle}" />
                        <CheckBox Grid.Column="2" Style="{StaticResource Toggle.Switch}" IsChecked="{Binding EnableAutoFailover}"
                                  VerticalAlignment="Center" AutomationProperties.Name="{l:Loc Resilience_FailoverTitle}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Local Proxy Configuration -->
            <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{l:Loc DnsMgr_LocalProxy}" Margin="0,12,0,10" />
            <Border Style="{StaticResource SectionCard}"
                    controls:ChartHoverInfoBehavior.Title="{l:Loc Info_DnsMgr_Proxy_Title}"
                    controls:ChartHoverInfoBehavior.Description="{l:Loc Info_DnsMgr_Proxy_Desc}"
                    controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Info_DnsMgr_Proxy_Meaning}"
                    controls:ChartHoverInfoBehavior.DelaySeconds="1.5">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{l:Loc DnsMgr_ListenEndpointLabel}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc DnsMgr_ListenEndpointDesc}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox Width="125" Text="{Binding ListenAddress, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Mono}"
                                     AutomationProperties.Name="{l:Loc DnsMgr_ListenEndpointLabel}" />
                            <TextBlock Text=":" VerticalAlignment="Center" Margin="6,0" FontFamily="{StaticResource Font.Mono}" />
                            <TextBox Width="86" Text="{Binding ListenPortText, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Mono}"
                                     AutomationProperties.Name="{l:Loc DnsMgr_ListenPort}" />
                            <Button Content="{l:Loc Common_Apply}" Command="{Binding ApplyProxySettingsCommand}" Margin="10,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Divider}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{l:Loc DnsMgr_EnableIpv6}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc DnsMgr_EnableIpv6Desc}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Toggle.Switch}" IsChecked="{Binding EnableIpv6}"
                                  AutomationProperties.Name="{l:Loc DnsMgr_EnableIpv6}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Windows Network Integration & Safety -->
            <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{l:Loc DnsMgr_WindowsSection}" Margin="0,12,0,10" />
            <Border Style="{StaticResource SectionCard}"
                    controls:ChartHoverInfoBehavior.Title="{l:Loc Info_DnsMgr_Windows_Title}"
                    controls:ChartHoverInfoBehavior.Description="{l:Loc Info_DnsMgr_Windows_Desc}"
                    controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Info_DnsMgr_Windows_Meaning}"
                    controls:ChartHoverInfoBehavior.DelaySeconds="1.5">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{l:Loc DnsMgr_ConfigureAdapter}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc DnsMgr_ConfigureAdapterDesc}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Toggle.Switch}" IsChecked="{Binding ConfigureWindowsAdapter}"
                                  AutomationProperties.Name="{l:Loc DnsMgr_ConfigureAdapter}" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{l:Loc DnsMgr_EmergencyRestore}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc DnsMgr_EmergencyRestoreDesc}" />
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding EmergencyRestoreDnsCommand}" Content="{l:Loc Tray_RestoreDns}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Network Adaptation & Browser DoH Canary Guard -->
            <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{l:Loc Dns_AdaptationSection}" Margin="0,12,0,10" />
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{l:Loc Dns_AutoAdaptNetwork}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc Dns_AutoAdaptNetwork_Desc}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Toggle.Switch}" IsChecked="{Binding AutoAdaptNetworkChanges}" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{l:Loc Dns_AutoDeferVpn}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc Dns_AutoDeferVpn_Desc}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Toggle.Switch}" IsChecked="{Binding AutoDeferToVpn}" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{l:Loc Dns_BlockFirefoxCanary}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{l:Loc Dns_BlockFirefoxCanary_Desc}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Toggle.Switch}" IsChecked="{Binding BlockFirefoxDohCanary}" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />
                    <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Command="{Binding PauseForCaptivePortalCommand}" Content="{l:Loc Dns_PauseCaptivePortal}"
                                Margin="0,0,8,0" Visibility="{Binding IsCaptivePortalPaused, Converter={StaticResource InverseBoolToVisibility}}" />
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding ResumeFromCaptivePortalCommand}"
                                Content="{l:Loc Dns_ResumeCaptivePortal}"
                                Visibility="{Binding IsCaptivePortalPaused, Converter={StaticResource BoolToVisibility}}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- DNSCrypt Engine Management -->
            <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{l:Loc DnsMgr_DnsCryptSection}" Margin="0,12,0,10" />
            <Border Style="{StaticResource SectionCard}"
                    controls:ChartHoverInfoBehavior.Title="{l:Loc Info_DnsMgr_DnsCrypt_Title}"
                    controls:ChartHoverInfoBehavior.Description="{l:Loc Info_DnsMgr_DnsCrypt_Desc}"
                    controls:ChartHoverInfoBehavior.MetricsMeaning="{l:Loc Info_DnsMgr_DnsCrypt_Meaning}"
                    controls:ChartHoverInfoBehavior.DelaySeconds="1.5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource RowTitle}" Text="dnscrypt-proxy" />
                            <Border Style="{StaticResource Pill}" Background="{DynamicResource Brush.SubtleHover}" Margin="10,0,0,0">
                                <TextBlock FontSize="{DynamicResource Font.Size.Caption}" Text="{Binding DnsCryptVersion}" />
                            </Border>
                        </StackPanel>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource TextBox.SelectableReadOnlyMono}" Text="{Binding DnsCryptPath, Mode=OneWay}"
                                     Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="NoWrap" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource Button.CopyInline}" Width="24" Height="24" Margin="4,0,0,0"
                                    controls:CopyTextBehavior.CopyText="{Binding DnsCryptPath}" />
                        </Grid>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding InstallOrUpdateDnsCryptCommand}" Content="{l:Loc DnsMgr_InstallUpdateDnsCrypt}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
