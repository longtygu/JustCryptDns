<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark theme palette. Accent brushes are injected at runtime by ThemeService. -->
    <Color x:Key="Color.WindowBackground">#FF0E1014</Color>
    <Color x:Key="Color.Sidebar">#FF121419</Color>
    <Color x:Key="Color.Card">#FF181B21</Color>
    <Color x:Key="Color.CardHover">#FF1E2229</Color>
    <Color x:Key="Color.CardBorder">#FF262A33</Color>
    <Color x:Key="Color.TextPrimary">#FFF1F3F7</Color>
    <Color x:Key="Color.TextSecondary">#FFA3AAB8</Color>
    <Color x:Key="Color.TextTertiary">#FF6C7380</Color>

    <SolidColorBrush x:Key="Brush.WindowBackground" Color="{StaticResource Color.WindowBackground}" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="{StaticResource Color.Sidebar}" />
    <SolidColorBrush x:Key="Brush.Card" Color="{StaticResource Color.Card}" />
    <SolidColorBrush x:Key="Brush.CardHover" Color="{StaticResource Color.CardHover}" />
    <SolidColorBrush x:Key="Brush.CardBorder" Color="{StaticResource Color.CardBorder}" />
    <SolidColorBrush x:Key="Brush.Divider" Color="#FF22262E" />

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="{StaticResource Color.TextTertiary}" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="#FF4C525C" />

    <SolidColorBrush x:Key="Brush.ControlFill" Color="#FF20242C" />
    <SolidColorBrush x:Key="Brush.ControlFillHover" Color="#FF282D36" />
    <SolidColorBrush x:Key="Brush.ControlFillPressed" Color="#FF1B1F26" />
    <SolidColorBrush x:Key="Brush.ControlBorder" Color="#FF30353F" />
    <SolidColorBrush x:Key="Brush.ControlBorderHover" Color="#FF3C424E" />
    <SolidColorBrush x:Key="Brush.SubtleHover" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Brush.SubtlePressed" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="Brush.Popup" Color="#FF1C2027" />

    <SolidColorBrush x:Key="Brush.CaptionCloseHover" Color="#FFC42B1C" />

    <SolidColorBrush x:Key="Brush.Success" Color="#FF3DD68C" />
    <SolidColorBrush x:Key="Brush.SuccessSubtle" Color="#1F3DD68C" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FFF5B946" />
    <SolidColorBrush x:Key="Brush.WarningSubtle" Color="#1FF5B946" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#FFFF6B6B" />
    <SolidColorBrush x:Key="Brush.DangerSubtle" Color="#1FFF6B6B" />
    <SolidColorBrush x:Key="Brush.Neutral" Color="#FF8B93A1" />
    <SolidColorBrush x:Key="Brush.NeutralSubtle" Color="#1F8B93A1" />

    <!-- Defaults; overridden by ThemeService with the user's accent color. -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF4F8CFF" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#FF6A9EFF" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#FF3F76DB" />
    <SolidColorBrush x:Key="Brush.AccentSubtle" Color="#264F8CFF" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#FF8AB3FF" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFFFF" />
</ResourceDictionary>
